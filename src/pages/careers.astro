---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import GooButton from '../components/GooButton.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { company } from '../data/site';
import { u } from '../lib/url';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const subject = encodeURIComponent('CV for BizCare');
---

<Base title="Careers" description="Work at BizCare Software Solutions in Lahore. How to send us your CV.">
  <PageHero label="Careers" title="Work at <span class='teal'>BizCare</span>" line="We are a Lahore team building software that businesses across Pakistan run on every day.">
    <div class="btn-row">
      <GooButton href={`mailto:${company.email}?subject=${subject}`} icon="envelope-simple">Email Your CV</GooButton>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap two">
      <div class="block reveal">
        <span class="n num">01</span>
        <h2 class="h3">Send Us Your CV</h2>
        <p class="muted">
          Email your CV to <a class="underline" href={`mailto:${company.email}?subject=${subject}`}>{company.email}</a>, with the kind of
          work you are looking for in the subject.
        </p>
      </div>
      <div class="block reveal">
        <span class="n num">02</span>
        <h2 class="h3">Soon on BizCareers</h2>
        <p class="muted">
          Our openings will be posted on BizCareers, our own jobs app for Pakistan, when it launches. You will be able to apply there in a
          few taps.
        </p>
        <a class="link" href={u('/apps/bizcareers/')}>About BizCareers <Icon name="caret-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section dark" aria-labelledby="team-title">
    <div class="wrap">
      <SectionHead id="team-title" label="Our Team" title="Who You Would Work With" />
      <ul class="team head-gap">
        {
          team.map((m) => (
            <li class="reveal">
              <div class="face">
                <Picture src={m.data.photo} alt={m.data.name} formats={['avif', 'webp']} widths={[240, 360, 480]} sizes="(max-width: 640px) 45vw, 200px" quality={70} loading="lazy" decoding="async" />
              </div>
              <p class="mname">{m.data.name}</p>
              <p class="mrole">{m.data.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Questions? <span class='teal'>Talk to Us</span>" line="Call or WhatsApp us, or email your CV and we will take it from there." message="Hello BizCare, I have a question about working at BizCare." />
</Base>

<style>
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .block { display: grid; gap: 14px; align-content: start; justify-items: start; padding-top: 28px; border-top: 2px solid var(--line); }
  .block:first-child { border-top-color: var(--teal); }
  .n { font-size: 0.875rem; font-weight: 800; color: var(--teal); }
  .team { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px; }
  .team li { display: grid; gap: 4px; align-content: start; }
  .face { aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius); background: #141414; margin-bottom: 14px; }
  .face :global(picture), .face :global(img) { width: 100%; height: 100%; }
  .face :global(img) { object-fit: cover; object-position: center 25%; }
  .mname { font-weight: 750; line-height: 1.3; }
  .mrole { font-size: 0.875rem; color: var(--d-ink-2); }
  @media (max-width: 960px) { .two { grid-template-columns: minmax(0, 1fr); } .team { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 14px; } }
</style>
