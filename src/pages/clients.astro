---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ClientMap from '../components/ClientMap.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCard from '../components/QuoteCard.astro';
import SectionHead from '../components/SectionHead.astro';

const regions = (await getCollection('regions')).sort((a, b) => a.data.order - b.data.order);
const clients = (await getCollection('clients')).sort((a, b) => b.data.since.localeCompare(a.data.since));
const quotes = await getCollection('quotes');
const inRegion = (id: string) => clients.filter((c) => c.data.region.id === id).length;
const regionName = Object.fromEntries(regions.map((r) => [r.id, r.data.name]));
const month = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((w) => /^[A-Za-z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('');
---

<Base
  title="Clients"
  description="300+ businesses across Pakistan run on BizCare. See 123 of the flour mills on BizCare ERP, region by region, with the date each one went live.">
  <PageHero
    label="Clients"
    title="300+ Businesses Run on BizCare"
    line="Here are 123 of the flour mills on BizCare ERP, with the date each one went live. Pick a region to see its mills."
  />

  <section class="section top" aria-labelledby="regions-title">
    <div class="wrap explore">
      <ClientMap interactive />
      <div class="side">
        <h2 class="h3" id="regions-title">Regions</h2>
        <ul class="regions" data-regions data-names={JSON.stringify(regionName)}>
          <li>
            <button type="button" class="region" data-region="" aria-pressed="true">
              <span>All Regions</span><span class="count num">{clients.length}</span>
            </button>
          </li>
          {
            regions
              .filter((r) => inRegion(r.id) > 0)
              .map((r) => (
                <li>
                  <button type="button" class="region" data-region={r.id} aria-pressed="false">
                    <span>{r.data.name}</span>
                    <span class="count num">{inRegion(r.id)}</span>
                  </button>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section list-section" aria-labelledby="list-title">
    <div class="wrap">
      <div class="list-head">
        <h2 class="h2" id="list-title" data-list-title>All Named Clients</h2>
        <div class="seg" role="group" aria-label="Edition" data-editions>
          <button type="button" data-edition="" aria-pressed="true">All</button>
          <button type="button" data-edition="cloud" aria-pressed="false">Cloud ERP</button>
          <button type="button" data-edition="desktop" aria-pressed="false">Desktop ERP</button>
        </div>
      </div>
      <p class="muted showing" aria-live="polite" data-showing>Showing all {clients.length} clients, newest first.</p>

      <ul class="clients" data-clients>
        {
          clients.map((c, i) => (
            <li class="client card" data-region={c.data.region.id} data-edition={c.data.edition}>
              <div class="photo">
                {c.data.photo ? (
                  <Picture
                    src={c.data.photo}
                    alt={`${c.data.name}, ${c.data.town}`}
                    formats={['avif', 'webp']}
                    widths={[240, 360, 480]}
                    sizes="(max-width: 640px) 50vw, (max-width: 960px) 33vw, 290px"
                    quality={62}
                    loading={i < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <span class="mono" aria-hidden="true">
                    {initials(c.data.name)}
                  </span>
                )}
              </div>
              <div class="info">
                <h3 class="cname">{c.data.name}</h3>
                <p class="ctown">{c.data.town}</p>
                <p class="cmeta">
                  <span class="pill">{c.data.edition === 'cloud' ? 'Cloud ERP' : 'Desktop ERP'}</span>
                  <span class="since num">Since {month(c.data.since)}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="empty muted" hidden data-empty>No clients match. Try another edition or region.</p>
    </div>
  </section>

  <section class="section band" aria-labelledby="quotes-title">
    <div class="wrap">
      <SectionHead id="quotes-title" center label="What Clients Say" title="In Their Own Words" />
      <div class="grid grid-3 quotes">
        {quotes.map((q) => <QuoteCard quote={q} />)}
      </div>
    </div>
  </section>

  <CtaBand title="Join 200+ Flour Mills on BizCare" product="bizcare-erp" message="Hello BizCare, I would like a demo of BizCare ERP for my mill." />
</Base>

<style>
  .top { padding-top: 0; }
  .explore {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
  }
  .explore :global(.map) { max-width: 600px; }
  .side { display: grid; gap: 16px; }
  .regions { display: grid; gap: 2px; }
  .region {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 10px;
    font-weight: 650;
    text-align: left;
    color: var(--ink-2);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .region:hover { background: var(--surface-2); color: var(--ink); }
  .region[aria-pressed='true'] { background: var(--ink); color: var(--page); }
  .count { font-size: 0.875rem; font-weight: 750; opacity: 0.8; }
  :global(html:not(.js)) .side, :global(html:not(.js)) .seg { display: none; }

  .list-section { padding-top: 0; }
  .list-head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 16px; }
  .seg {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .seg button {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink-2);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--page); }
  .showing { margin: 12px 0 28px; }

  .clients {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .client { overflow: hidden; display: flex; flex-direction: column; }
  .client[hidden] { display: none; }
  .photo { aspect-ratio: 4 / 3; background: var(--surface-2); overflow: hidden; display: grid; place-items: center; }
  .photo :global(picture), .photo :global(img) { width: 100%; height: 100%; }
  .photo :global(img) { object-fit: cover; object-position: center 35%; }
  .mono { font-size: 1.75rem; font-weight: 800; color: var(--ink-3); letter-spacing: 0.02em; }
  .info { display: grid; gap: 2px; padding: 14px 16px 16px; flex: 1; align-content: start; }
  .cname { font-size: 1rem; font-weight: 750; line-height: 1.3; }
  .ctown { font-size: 0.875rem; color: var(--ink-2); }
  .cmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 10px; }
  .since { font-size: 0.8125rem; color: var(--ink-3); font-weight: 650; }
  .empty { padding: 40px 0; text-align: center; }

  @media (max-width: 960px) {
    .explore { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .explore :global(.map) { justify-self: center; }
    .regions { display: flex; flex-wrap: wrap; gap: 8px; }
    .region { width: auto; border: 1px solid var(--line); border-radius: 999px; }
    .region[aria-pressed='true'] { border-color: var(--ink); }
    .clients { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .clients { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .info { padding: 12px; }
    .cname { font-size: 0.9375rem; }
    .quotes { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const names: Record<string, string> = JSON.parse(document.querySelector<HTMLElement>('[data-regions]')!.dataset.names!);
  const cards = [...document.querySelectorAll<HTMLElement>('[data-clients] > li')];
  const regionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-regions] [data-region], [data-map] [data-region]')];
  const editionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-editions] [data-edition]')];
  const title = document.querySelector<HTMLElement>('[data-list-title]')!;
  const showing = document.querySelector<HTMLElement>('[data-showing]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  const params = new URLSearchParams(location.search);
  let region = names[params.get('region') ?? ''] ? params.get('region')! : '';
  let edition = ['cloud', 'desktop'].includes(params.get('edition') ?? '') ? params.get('edition')! : '';

  const apply = (scroll = false) => {
    let shown = 0;
    for (const card of cards) {
      const match = (!region || card.dataset.region === region) && (!edition || card.dataset.edition === edition);
      card.hidden = !match;
      if (match) shown++;
    }
    regionButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.region ?? '') === region)));
    editionButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.edition ?? '') === edition)));
    const kind = edition === 'cloud' ? ' on Cloud ERP' : edition === 'desktop' ? ' on Desktop ERP' : '';
    title.textContent = region ? `Clients in ${names[region]}` : 'All Named Clients';
    showing.textContent = `Showing ${shown} ${shown === 1 ? 'client' : 'clients'}${kind}, newest first.`;
    empty.hidden = shown > 0;

    const next = new URLSearchParams();
    if (region) next.set('region', region);
    if (edition) next.set('edition', edition);
    const query = next.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
    if (scroll) title.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  regionButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.region ?? '';
      region = region === id ? '' : id;
      // From the map, take the visitor to the list.
      apply(b.closest('[data-map]') !== null && matchMedia('(max-width: 960px)').matches);
    }),
  );
  editionButtons.forEach((b) =>
    b.addEventListener('click', () => {
      edition = b.dataset.edition ?? '';
      apply();
    }),
  );
  if (region || edition) apply();
</script>
