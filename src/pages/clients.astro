---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import Testimonials from '../components/Testimonials.astro';

const regions = (await getCollection('regions')).sort((a, b) => a.data.order - b.data.order);
const clients = (await getCollection('clients')).sort((a, b) => b.data.since.localeCompare(a.data.since));
const inRegion = (id: string) => clients.filter((c) => c.data.region.id === id).length;
const regionName = Object.fromEntries(regions.map((r) => [r.id, r.data.name]));
const month = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((w) => /^[A-Za-z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('');
---

<Base
  title="Clients"
  description="300+ businesses across Pakistan run on BizCare. See 123 of the flour mills on BizCare ERP, region by region, with the date each one went live.">
  <PageHero
    label="Clients"
    title="300+ Businesses <span class='teal'>Run on BizCare</span>"
    line="Here are 123 of the flour mills on BizCare ERP, each pictured with our team on the day it went live."
  >
    <div class="hero-stats"><Stats /></div>
  </PageHero>

  <section class="section list" aria-labelledby="list-title">
    <div class="wrap">
      <div class="filters">
        <div class="chips-scroll">
          <ul class="chips" data-regions data-names={JSON.stringify(regionName)}>
            <li><button type="button" class="chip" data-region="" aria-pressed="true">All Regions <span class="c num">{clients.length}</span></button></li>
            {
              regions
                .filter((r) => inRegion(r.id) > 0)
                .map((r) => (
                  <li>
                    <button type="button" class="chip" data-region={r.id} aria-pressed="false">
                      {r.data.short} <span class="c num">{inRegion(r.id)}</span>
                    </button>
                  </li>
                ))
            }
          </ul>
        </div>
        <div class="seg" role="group" aria-label="Edition" data-editions>
          <button type="button" data-edition="" aria-pressed="true">All</button>
          <button type="button" data-edition="cloud" aria-pressed="false">Cloud ERP</button>
          <button type="button" data-edition="desktop" aria-pressed="false">Desktop ERP</button>
        </div>
      </div>

      <div class="list-head">
        <h2 class="h2" id="list-title" data-list-title>All Named Clients</h2>
        <p class="muted" aria-live="polite" data-showing>Showing all {clients.length} clients, newest first.</p>
      </div>

      <ul class="clients" data-clients>
        {
          clients.map((c, i) => (
            <li class="client" data-region={c.data.region.id} data-edition={c.data.edition}>
              <div class="photo">
                {c.data.photo ? (
                  <Picture
                    src={c.data.photo}
                    alt={`${c.data.name}, ${c.data.town}`}
                    formats={['avif', 'webp']}
                    widths={[240, 360, 480]}
                    sizes="(max-width: 640px) 50vw, (max-width: 960px) 33vw, 300px"
                    quality={62}
                    loading={i < 8 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <span class="mono" aria-hidden="true">{initials(c.data.name)}</span>
                )}
                <span class="ed">{c.data.edition === 'cloud' ? 'Cloud ERP' : 'Desktop ERP'}</span>
              </div>
              <h3 class="cname">{c.data.name}</h3>
              <p class="ctown">{c.data.town}</p>
              <p class="since num">Since {month(c.data.since)}</p>
            </li>
          ))
        }
      </ul>
      <p class="empty muted" hidden data-empty>No clients match. Try another edition or region.</p>
    </div>
  </section>

  <section class="section dark" aria-labelledby="tst-title">
    <div class="wrap">
      <span class="eyebrow reveal" id="tst-title">What Clients Say</span>
      <div class="tst-gap"><Testimonials /></div>
    </div>
  </section>

  <CtaBand title="Join 200+ Flour Mills <span class='teal'>on BizCare</span>" product="bizcare-erp" message="Hello BizCare, I would like a demo of BizCare ERP for my mill." />
</Base>

<style>
  .hero-stats { width: 100%; max-width: none !important; margin-top: 48px; }
  .list { padding-top: 80px; }
  .filters { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .chips-scroll { flex: 1 1 600px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .chips-scroll::-webkit-scrollbar { display: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.9375rem;
    font-weight: 650;
    white-space: nowrap;
    transition: all 0.2s var(--ease);
  }
  .chip:hover { border-color: var(--ink); }
  .chip .c { font-size: 0.8125rem; color: var(--ink-3); }
  .chip[aria-pressed='true'] { background: var(--black); border-color: var(--black); color: var(--white); }
  .chip[aria-pressed='true'] .c { color: #bdbdbd; }
  .seg { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--bg-soft); }
  .seg button { min-height: 40px; padding: 0 16px; border-radius: 999px; font-size: 0.9375rem; font-weight: 700; color: var(--ink-2); transition: all 0.2s var(--ease); }
  .seg button[aria-pressed='true'] { background: var(--white); color: var(--ink); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
  :global(html:not(.js)) .filters { display: none; }

  .list-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin: 64px 0 36px; }

  .clients { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 20px; }
  .client[hidden] { display: none; }
  .photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--bg-soft); display: grid; place-items: center; margin-bottom: 14px; }
  .photo :global(picture), .photo :global(img) { width: 100%; height: 100%; }
  .photo :global(img) { object-fit: cover; object-position: center 35%; transition: transform 0.6s var(--ease); }
  .client:hover .photo :global(img) { transform: scale(1.04); }
  .mono { font-size: 2rem; font-weight: 800; color: #b0b0b0; }
  .ed { position: absolute; left: 10px; top: 10px; padding: 4px 10px; border-radius: 999px; background: rgb(0 0 0 / 0.7); color: #fff; font-size: 0.75rem; font-weight: 700; }
  .cname { font-size: 1.0625rem; font-weight: 750; line-height: 1.3; letter-spacing: -0.01em; }
  .ctown { font-size: 0.9375rem; color: var(--ink-2); }
  .since { margin-top: 4px; font-size: 0.8125rem; font-weight: 650; color: var(--ink-3); }
  .empty { padding: 48px 0; text-align: center; }
  .tst-gap { margin-top: 48px; }

  @media (max-width: 960px) {
    .clients { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .chips { flex-wrap: nowrap; }
    .chips-scroll { flex-basis: 100%; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  }
  @media (max-width: 640px) {
    .list { padding-top: 56px; }
    .clients { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 12px; }
    .cname { font-size: 0.9375rem; }
    .ctown { font-size: 0.875rem; }
    .list-head { margin: 40px 0 24px; }
  }
</style>

<script>
  const names: Record<string, string> = JSON.parse(document.querySelector<HTMLElement>('[data-regions]')!.dataset.names!);
  const cards = [...document.querySelectorAll<HTMLElement>('[data-clients] > li')];
  const regionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-regions] [data-region]')];
  const editionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-editions] [data-edition]')];
  const title = document.querySelector<HTMLElement>('[data-list-title]')!;
  const showing = document.querySelector<HTMLElement>('[data-showing]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  const params = new URLSearchParams(location.search);
  let region = names[params.get('region') ?? ''] ? params.get('region')! : '';
  let edition = ['cloud', 'desktop'].includes(params.get('edition') ?? '') ? params.get('edition')! : '';

  const apply = () => {
    let shown = 0;
    for (const card of cards) {
      const match = (!region || card.dataset.region === region) && (!edition || card.dataset.edition === edition);
      card.hidden = !match;
      if (match) shown++;
    }
    regionButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.region ?? '') === region)));
    editionButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.edition ?? '') === edition)));
    const kind = edition === 'cloud' ? ' on Cloud ERP' : edition === 'desktop' ? ' on Desktop ERP' : '';
    title.textContent = region ? `Clients in ${names[region]}` : 'All Named Clients';
    showing.textContent = `Showing ${shown} ${shown === 1 ? 'client' : 'clients'}${kind}, newest first.`;
    empty.hidden = shown > 0;
    const next = new URLSearchParams();
    if (region) next.set('region', region);
    if (edition) next.set('edition', edition);
    const query = next.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  };

  regionButtons.forEach((b) =>
    b.addEventListener('click', () => {
      region = b.dataset.region ?? '';
      apply();
      b.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    }),
  );
  editionButtons.forEach((b) =>
    b.addEventListener('click', () => {
      edition = b.dataset.edition ?? '';
      apply();
    }),
  );
  if (region || edition) apply();
</script>
