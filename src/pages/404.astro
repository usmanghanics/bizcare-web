---
import Base from '../layouts/Base.astro';
import FillButton from '../components/FillButton.astro';
import GooButton from '../components/GooButton.astro';
import { u } from '../lib/url';
---

<Base title="Page Not Found" description="This page could not be found." noindex>
  <section class="lost dark">
    <div class="wrap inner">
      <h1 class="mega">This Page <span class="teal">Is Not Here</span></h1>
      <p class="lede">The link may be old, or the page may have moved. These will get you back on track.</p>
      <div class="btn-row">
        <FillButton href={u('/products/')}>Products</FillButton>
        <GooButton href={u('/')} icon="house">Go Home</GooButton>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 88vh; display: grid; align-items: center; padding: calc(var(--bar) + 64px) 0 96px; }
  .inner { display: grid; gap: 28px; justify-items: start; }
  .inner .lede { max-width: 560px; }
</style>
