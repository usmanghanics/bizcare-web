---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import NumberStrip from '../components/NumberStrip.astro';
import PageHero from '../components/PageHero.astro';
import Sample from '../components/Sample.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import { company } from '../data/site';
import { u } from '../lib/url';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const affiliations = (await getCollection('affiliations')).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="About"
  description="BizCare Software Solutions is a Lahore software company. 300+ businesses in 70+ cities run on its software, including 200+ flour mills.">
  <PageHero
    label="About BizCare"
    title="Software for the Businesses That Keep Pakistan Running"
    line="BizCare Software Solutions is a software company in Lahore. Flour mills, shops, restaurants, travel agencies, workshops and internet providers across Pakistan run on what we build."
  />

  <NumberStrip />

  <section class="section" aria-labelledby="story-title">
    <div class="wrap story">
      <SectionHead id="story-title" label="Our Story" title="Built Around One Kind of Business at a Time" />
      <div class="story-text reveal">
        <p>
          BizCare is best known for flour mill software. More than 200 mills, from Peshawar and Swat to Quetta, Turbat
          and Sindh, run their purchase, production, stock, sales and accounts on BizCare ERP.
        </p>
        <p>
          Over seven years the same approach has grown into a product for each kind of business:
          {products.map((p, i) => (
            <>
              <a class="underline" href={u(`/products/${p.id}/`)}>{p.data.name}</a>
              {i < products.length - 2 ? ', ' : i === products.length - 2 ? ' and ' : '.'}
            </>
          ))}
          Every one of them sends invoices, reminders and receipts to customers on WhatsApp.
        </p>
        <p>
          We also build phone apps that put a client's records in their customers' hands, like Makki AutoCare for Makki
          Oil Store, and BizCareers, our own jobs app for Pakistan.
        </p>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="how-title">
    <div class="wrap">
      <SectionHead id="how-title" center label="How We Work" title="From First Call to Every Day After" />
      <Steps />
    </div>
  </section>

  <section class="section" aria-labelledby="team-title">
    <div class="wrap">
      <SectionHead id="team-title" label="Our Team" title="The Team Behind BizCare" />
      <ul class="team">
        {
          team.map((m) => (
            <li class="member reveal">
              <div class="face">
                <Picture
                  src={m.data.photo}
                  alt={m.data.name}
                  formats={['avif', 'webp']}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 640px) 45vw, 200px"
                  quality={70}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="mname">{m.data.name}</p>
              <p class="mrole">{m.data.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="aff-title">
    <div class="wrap">
      <SectionHead id="aff-title" label="Recognition" title="Listings and Memberships" />
      <ul class="grid grid-4">
        {
          affiliations.map((a) => {
            const Tag = a.data.url ? 'a' : 'div';
            return (
              <li class="reveal">
                <Tag class="aff card" href={a.data.url} target={a.data.url ? '_blank' : undefined} rel={a.data.url ? 'noopener' : undefined}>
                  <div class="aff-top">
                    <span class="tile">
                      <Icon name={a.data.icon} size={22} />
                    </span>
                    <Sample when={a.data.sample} />
                    {a.data.url && <Icon name="arrow-up-right" size={18} class="ext" />}
                  </div>
                  <h3 class="h3">{a.data.name}</h3>
                  <p class="muted small">{a.data.line}</p>
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="visit-title">
    <div class="wrap">
      <div class="visit card reveal">
        <div>
          <span class="label">Visit Us</span>
          <h2 class="h3" id="visit-title">{company.name}</h2>
          <p class="muted">{company.address}</p>
        </div>
        <a class="btn btn-quiet" href={company.mapsHref} target="_blank" rel="noopener">
          <Icon name="map-pin" /> Open in Google Maps
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: start; }
  .story :global(.head + *) { margin-top: 0; }
  .story-text { display: grid; gap: 18px; font-size: 1.125rem; line-height: 1.65; color: var(--ink-2); }

  .team { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px; }
  .member { display: grid; gap: 2px; align-content: start; }
  .face { aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); margin-bottom: 12px; }
  .face :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .mname { font-weight: 750; line-height: 1.3; }
  .mrole { font-size: 0.875rem; color: var(--ink-2); line-height: 1.4; }

  .aff { display: grid; gap: 10px; align-content: start; height: 100%; padding: 24px; transition: border-color 0.2s var(--ease); }
  a.aff:hover { border-color: var(--line-strong); }
  .aff-top { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .aff-top :global(.sample-tag) { margin-left: auto; }
  .aff-top :global(.ext) { margin-left: auto; color: var(--ink-3); }
  .grid-4 > li { display: block; }

  .visit { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: 28px 32px; }
  .visit > div { display: grid; gap: 6px; }

  @media (max-width: 960px) {
    .story { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .team { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .story-text { font-size: 1.0625rem; }
    .visit { padding: 24px; }
  }
</style>
