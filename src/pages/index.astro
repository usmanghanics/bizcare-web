---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroMosaic from '../components/HeroMosaic.astro';
import Icon from '../components/Icon.astro';
import NameMarquee from '../components/NameMarquee.astro';
import ProductList from '../components/ProductList.astro';
import RegionCards from '../components/RegionCards.astro';
import SectionHead from '../components/SectionHead.astro';
import Services from '../components/Services.astro';
import Stats from '../components/Stats.astro';
import Steps from '../components/Steps.astro';
import Testimonials from '../components/Testimonials.astro';
import WorkCard from '../components/WorkCard.astro';
import { company } from '../data/site';
import { u } from '../lib/url';

const makki = (await getEntry('apps', 'makki-autocare'))!;
const others = (await getCollection('apps')).filter((a) => a.id !== 'makki-autocare').sort((a, b) => a.data.order - b.data.order);
const clients = await getCollection('clients');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  alternateName: 'BizCare',
  url: new URL(u('/'), Astro.site).href,
  logo: new URL(u('/apple-touch-icon.png'), Astro.site).href,
  email: company.email,
  telephone: company.phone,
  address: { '@type': 'PostalAddress', streetAddress: 'Al-Hamd Garden', addressLocality: 'Lahore', addressCountry: 'PK' },
};
---

<Base
  title="BizCare | Software That Runs Pakistan’s Businesses"
  fullTitle
  description="BizCare Software Solutions is a Lahore software house. ERP, point of sale and mobile apps for flour mills, retail, restaurants, travel agencies, workshops and internet providers. Trusted by 300+ businesses."
  schema={schema}>
  <!-- Hero -->
  <section class="hero dark">
    <div class="wrap hero-grid">
      <div class="copy">
        <span class="eyebrow">Software House, Lahore</span>
        <h1 class="mega">Software That Runs <span class="teal">Pakistan’s</span> Businesses</h1>
        <p class="lede">
          ERP, point of sale and mobile apps for flour mills, retailers, restaurants, travel agencies, workshops and internet
          providers.
        </p>
        <div class="btn-row">
          <a class="btn btn-teal" href={u('/contact/')}>Book a Demo <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-line" href="#work">See Our Work</a>
        </div>
      </div>
      <HeroMosaic />
    </div>
    <div class="wrap proof">
      <p class="proof-label">Trusted by <b>300+ businesses</b> in 70+ cities</p>
      <NameMarquee />
    </div>
  </section>

  <!-- Who we are -->
  <section class="section" aria-labelledby="who-title">
    <div class="wrap">
      <span class="eyebrow reveal" id="who-title">Who We Are</span>
      <p class="statement reveal who">
        BizCare is a software house in Lahore. For seven years we have built, installed and supported the software that
        <span class="quiet">flour mills, shops, restaurants, travel agencies, workshops and internet providers across Pakistan run on every day.</span>
      </p>
      <div class="stats-gap"><Stats /></div>
      <a class="link reveal about-link" href={u('/about/')}>More About BizCare <Icon name="arrow-right" size={18} /></a>
    </div>
  </section>

  <!-- What we build -->
  <section class="section dark" aria-labelledby="build-title">
    <div class="wrap">
      <div class="head-row">
        <SectionHead
          id="build-title"
          label="What We Build"
          title="One Product for Each Kind of Business"
          line="Every product sends invoices, reminders and receipts to your customers on WhatsApp."
        />
        <a class="btn btn-line reveal" href={u('/products/')}>All Products</a>
      </div>
      <div class="head-gap"><ProductList /></div>
    </div>
  </section>

  <!-- Our work -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="head-row">
        <SectionHead id="work-title" label="Our Work" title="Apps We Have Built" line="For our clients’ customers, and for Pakistan’s job market." />
        <a class="btn btn-line reveal" href={u('/apps/')}>All Apps</a>
      </div>
      <div class="work head-gap">
        <WorkCard app={makki} wide />
        <div class="work-pair">
          {others.map((a) => <WorkCard app={a} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Across Pakistan -->
  <section class="section soft" aria-labelledby="regions-title">
    <div class="wrap">
      <SectionHead
        id="regions-title"
        label="Clients Across Pakistan"
        title="From Peshawar to Turbat"
        line={`${clients.length} named clients in 14 regions, and 300+ businesses in all. Our team installs and trains at every one.`}
      />
      <div class="head-gap"><RegionCards /></div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead id="services-title" label="Services" title="Everything Your Business Needs From Software" />
      <div class="head-gap"><Services /></div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section dark" aria-labelledby="tst-title">
    <div class="wrap">
      <span class="eyebrow reveal" id="tst-title">What Clients Say</span>
      <div class="tst-gap"><Testimonials /></div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <SectionHead id="how-title" label="How We Work" title="From First Call to Every Day After" />
      <div class="head-gap"><Steps /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-top: calc(var(--bar) + 48px); overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }
  .copy { display: grid; gap: 30px; justify-items: start; padding-bottom: 40px; }
  .copy .lede { max-width: 520px; }
  .proof {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    margin-top: 24px;
    padding-top: 32px;
    padding-bottom: 40px;
    border-top: 1px solid #1f1f1f;
  }
  .proof-label { font-size: 0.9375rem; color: var(--d-ink-2); white-space: nowrap; }
  .proof-label b { color: var(--white); }

  .who { margin-top: 28px; max-width: 1100px; }
  .stats-gap { margin-top: 80px; }
  .about-link { margin-top: 48px; }

  .work { display: grid; gap: 24px; }
  .work-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }

  .tst-gap { margin-top: 48px; }

  @media (max-width: 960px) {
    .hero { padding-top: calc(var(--bar) + 40px); }
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .copy { padding-bottom: 0; }
    .proof { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-top: 40px; }
    .work-pair { grid-template-columns: minmax(0, 1fr); }
    .stats-gap { margin-top: 56px; }
  }
  @media (max-width: 480px) {
    .copy .btn-row { width: 100%; }
    .copy .btn-row .btn { flex: 1 1 auto; }
  }
</style>
