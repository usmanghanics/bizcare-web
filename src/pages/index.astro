---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import FillButton from '../components/FillButton.astro';
import GooButton from '../components/GooButton.astro';
import HeroMosaic from '../components/HeroMosaic.astro';
import ProductGrid from '../components/ProductGrid.astro';
import RegionCards from '../components/RegionCards.astro';
import SectionHead from '../components/SectionHead.astro';
import Testimonials from '../components/Testimonials.astro';
import TrustBar from '../components/TrustBar.astro';
import WorkCard from '../components/WorkCard.astro';
import { company } from '../data/site';
import { u } from '../lib/url';

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const order = ['makki-autocare', 'madadgar-kisan', 'bizcareers'];
apps.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const clients = await getCollection('clients');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  alternateName: 'BizCare',
  url: new URL(u('/'), Astro.site).href,
  logo: new URL(u('/apple-touch-icon.png'), Astro.site).href,
  email: company.email,
  telephone: company.phone,
  address: { '@type': 'PostalAddress', streetAddress: 'Al-Hamd Garden', addressLocality: 'Lahore', addressCountry: 'PK' },
};
---

<Base
  title="BizCare | Business Software and Apps"
  fullTitle
  description="BizCare Software Solutions builds ERP, point of sale and mobile apps for flour mills, retail, restaurants, travel agencies, workshops and internet providers. Trusted by 300+ businesses."
  schema={schema}>
  <!-- Hero -->
  <section class="hero dark">
    <div class="wrap hero-grid">
      <div class="copy">
        <h1 class="display">We Build the Software <span class="teal">Businesses Run On</span></h1>
        <p class="lede">ERP, point of sale and mobile apps, built in Lahore and trusted by more than 300 businesses.</p>
        <div class="btn-row">
          <FillButton href="#work">See Our Work</FillButton>
          <GooButton href={u('/contact/')} icon="calendar-check">Book a Demo</GooButton>
        </div>
      </div>
      <HeroMosaic />
    </div>
    <div class="wrap"><TrustBar /></div>
  </section>

  <!-- What we build -->
  <section class="section" aria-labelledby="build-title">
    <div class="wrap">
      <SectionHead
        id="build-title"
        title="Software for Every Kind of Business"
        line="Pick the one made for your work. Each sends invoices and reminders to your customers on WhatsApp."
      />
      <div class="head-gap"><ProductGrid /></div>
    </div>
  </section>

  <!-- Apps -->
  <section class="section dark" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead id="work-title" title="Apps We Have Built" line="On the App Store and Google Play, for our clients and for our own customers." />
      <div class="apps head-gap">
        {apps.map((a) => <WorkCard app={a} />)}
      </div>
    </div>
  </section>

  <!-- Across Pakistan -->
  <section class="section soft" aria-labelledby="regions-title">
    <div class="wrap">
      <SectionHead
        id="regions-title"
        title="From Peshawar to Turbat"
        line={`${clients.length} named clients in 14 regions. Our team installs and trains at every one.`}
      />
      <div class="head-gap"><RegionCards /></div>
    </div>
  </section>

  <!-- Client words -->
  <section class="section dark" aria-labelledby="tst-title">
    <div class="wrap">
      <h2 class="h2 reveal" id="tst-title">What Clients Say</h2>
      <div class="tst-gap"><Testimonials /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding-top: calc(var(--bar) + 40px); overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 72px;
    align-items: center;
  }
  .copy { display: grid; gap: 28px; justify-items: start; }
  .copy .display { font-size: clamp(2.75rem, 1.6rem + 3.8vw, 4.75rem); max-width: 11ch; }
  .copy .lede { max-width: 30ch; color: rgb(255 255 255 / 0.66); }
  .copy .btn-row { margin-top: 8px; }

  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .tst-gap { margin-top: 56px; }

  @media (max-width: 960px) {
    .hero { padding-top: calc(var(--bar) + 32px); }
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 44px; }
    .copy .display { max-width: 13ch; }
    .apps { grid-template-columns: minmax(0, 1fr); gap: 56px; max-width: 520px; }
  }
  @media (max-width: 480px) {
    .copy .btn-row { width: 100%; }
  }
</style>
