---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Frame from '../../components/Frame.astro';
import Icon from '../../components/Icon.astro';
import Numbered from '../../components/Numbered.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import { u } from '../../lib/url';

export const getStaticPaths = (async () => {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}) satisfies GetStaticPaths;

interface Props {
  app: CollectionEntry<'apps'>;
}
const { app } = Astro.props;
const a = app.data;
const product = a.poweredBy ? await getEntry(a.poweredBy) : undefined;
const live = a.status === 'live';
const others = (await getCollection('apps')).filter((x) => x.id !== app.id).sort((x, y) => x.data.order - y.data.order);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: a.name,
  operatingSystem: a.platforms.join(', '),
  applicationCategory: 'BusinessApplication',
  description: a.line,
  ...(a.links.play ? { installUrl: a.links.play } : {}),
  publisher: { '@type': 'Organization', name: 'BizCare Software Solutions (Pvt.) Ltd.' },
};
---

<Base title={a.name} description={`${a.name}: ${a.tagline}`} image={`/og/apps/${app.id}.png`} schema={schema}>
  <section class="hero dark">
    <div class="wrap hero-grid">
      <div class="copy">
        <nav class="crumb small" aria-label="Breadcrumb">
          <a href={u('/apps/')}>Our Work</a>
          <Icon name="caret-right" size={14} />
          <span aria-current="page">{a.name}</span>
        </nav>
        <span class="eyebrow">{a.kind === 'own' ? 'BizCare Product' : `Client: ${a.client}`}</span>
        <h1 class="display">{a.headline}</h1>
        <p class="lede">{a.line}</p>
        <div class="btn-row">
          {a.links.play && (
            <a class="btn btn-teal" href={a.links.play} target="_blank" rel="noopener"><Icon name="google-play-logo" /> Get It on Google Play</a>
          )}
          {a.links.site && (
            <a class="btn btn-line" href={a.links.site} target="_blank" rel="noopener">Visit {a.name} <Icon name="arrow-up-right" size={16} /></a>
          )}
          {!a.links.play && !a.links.site && (
            <a class="btn btn-teal" href={u('/contact/?product=custom-app')}>Talk to Us About an App <Icon name="arrow-right" size={18} /></a>
          )}
        </div>
        <ul class="facts small">
          <li class:list={['status', { live }]}><span class="dot" aria-hidden="true"></span>{live ? 'Live on Google Play' : 'Coming Soon'}</li>
          <li><Icon name="device-mobile" size={18} /> {a.platforms.join(', ')}</li>
        </ul>
      </div>
      <div class="stage">
        {a.screens.map((s, i) => <Frame kind="phone" src={s.src} alt={s.alt} sizes="(max-width: 640px) 30vw, 220px" priority={i === 0} class={`ph p${i}`} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="does-title">
    <div class="wrap">
      <SectionHead id="does-title" label="What It Does" title={`Inside ${a.name}`} />
      <div class="head-gap">
        <Numbered items={a.features.map((f) => ({ title: f.title, line: f.line }))} columns={a.features.length % 3 === 0 ? 3 : 2} />
      </div>
    </div>
  </section>

  {
    product && (
      <section class="section soft" aria-labelledby="behind-title">
        <div class="wrap behind">
          <div class="behind-copy">
            <SectionHead
              id="behind-title"
              label="The Software Behind It"
              title={`Powered by ${product.data.name}`}
              line={`${a.client} runs ${product.data.name}, BizCare’s software for ${product.data.industry.toLowerCase()}. The app shows each customer the records it keeps.`}
            />
            <a class="btn btn-line reveal" href={u(`/products/${product.id}/`)}>See {product.data.name} <Icon name="arrow-right" size={18} /></a>
          </div>
          <Frame kind={product.data.screen.frame} src={product.data.screen.src} alt={product.data.screen.alt} title={product.data.screen.title} sizes="(max-width: 960px) 100vw, 680px" />
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="more-title">
    <div class="wrap">
      <SectionHead id="more-title" label="More Work" title="Other Apps We Have Built" />
      <div class="pair head-gap">{others.map((o) => <WorkCard app={o} />)}</div>
    </div>
  </section>

  <CtaBand
    title="Want an App for <span class='teal'>Your Customers?</span>"
    line="If your business runs on BizCare, your customers can see their records in an app of your own."
    message="Hello BizCare, I would like to talk about an app for my customers."
  />
</Base>

<style>
  .hero { padding: calc(var(--bar) + 72px) 0 0; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: end; }
  .copy { display: grid; gap: 24px; justify-items: start; padding-bottom: 104px; }
  .copy .display { font-size: clamp(2.25rem, 1.4rem + 3vw, 4rem); }
  .crumb { display: flex; align-items: center; gap: 8px; color: var(--d-ink-3); }
  .crumb a:hover { color: var(--white); }
  .crumb [aria-current] { color: var(--d-ink-2); }
  .facts { display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--d-ink-2); font-weight: 650; }
  .facts li { display: inline-flex; align-items: center; gap: 8px; }
  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: #777; }
  .status.live .dot { background: #3ccf73; }
  .stage {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
    padding: 56px 32px 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: #111;
    border: 1px solid #1f1f1f;
    border-bottom: 0;
    height: 560px;
    overflow: hidden;
  }
  .stage :global(.ph) { width: 31%; max-width: 220px; flex: none; }
  .stage :global(.p1) { margin-top: 44px; }
  .stage :global(.p2) { margin-top: 88px; }
  .behind { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px; align-items: center; }
  .behind-copy { display: grid; gap: 28px; justify-items: start; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 960px) {
    .hero-grid, .behind, .pair { grid-template-columns: minmax(0, 1fr); }
    .copy { padding-bottom: 0; }
    .stage { height: 440px; padding: 36px 16px 0; gap: 12px; }
  }
  @media (max-width: 560px) {
    .stage { height: 360px; margin-inline: calc(-1 * var(--gutter)); border-radius: 0; border-inline: 0; }
    .copy .btn-row { width: 100%; }
    .copy .btn-row .btn { flex: 1 1 auto; }
  }
</style>
