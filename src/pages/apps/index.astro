---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import WorkCard from '../../components/WorkCard.astro';

const order = ['makki-autocare', 'madadgar-kisan', 'bizcareers'];
const apps = (await getCollection('apps')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Base
  title="Apps"
  description="Phone apps by BizCare: Makki AutoCare for Makki Oil Store, Madadgar Kisan for Chaudhary Trading Company, and BizCareers, our own jobs app.">
  <PageHero
    title="Apps We <span class='teal'>Have Built</span>"
    line="On the App Store and Google Play, for our clients and for our own customers."
  />
  <section class="section dark">
    <div class="wrap apps">{apps.map((a) => <WorkCard app={a} />)}</div>
  </section>
  <CtaBand
    title="Want an App for <span class='teal'>Your Customers?</span>"
    line="If your business runs on BizCare, your customers can see their records in an app of your own."
    message="Hello BizCare, I would like to talk about an app for my customers."
  />
</Base>

<style>
  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  @media (max-width: 960px) { .apps { grid-template-columns: minmax(0, 1fr); gap: 56px; max-width: 520px; } }
</style>
