---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import SectionHead from '../../components/SectionHead.astro';
import Services from '../../components/Services.astro';
import WorkCard from '../../components/WorkCard.astro';

const order = ['makki-autocare', 'madadgar-kisan', 'bizcareers'];
const apps = (await getCollection('apps')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Base
  title="Products"
  description="BizCare ERP for flour mills, BizPOS for retail, Restro for restaurants, BizWay for travel agencies, OilMate for workshops and RecovrPro for internet and cable, plus apps and WhatsApp messaging.">
  <PageHero
    title="One Product for Each <span class='teal'>Kind of Business</span>"
    line="Six products, each built around how one kind of business works."
  />

  <section class="section">
    <div class="wrap"><ProductGrid /></div>
  </section>

  <section class="section dark" id="apps" aria-labelledby="apps-title">
    <div class="wrap">
      <SectionHead id="apps-title" title="Apps We Have Built" line="On the App Store and Google Play." />
      <div class="apps head-gap">{apps.map((a) => <WorkCard app={a} />)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead id="services-title" title="Services" />
      <div class="head-gap"><Services /></div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  @media (max-width: 960px) { .apps { grid-template-columns: minmax(0, 1fr); gap: 56px; max-width: 520px; } }
</style>
