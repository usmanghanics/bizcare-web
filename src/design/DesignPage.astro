---
/** The design system on one page, for review. Preview builds only (astro.config.mjs). */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Numbered from '../components/Numbered.astro';
import PageHero from '../components/PageHero.astro';
import Sample from '../components/Sample.astro';
import Stats from '../components/Stats.astro';
import WhatsAppMessage from '../components/WhatsAppMessage.astro';

const colours = [
  ['#000000', 'Black (logo)'],
  ['#017E84', 'Teal (logo dot)'],
  ['#2BB8BF', 'Teal on black'],
  ['#FFFFFF', 'White'],
  ['#F4F4F4', 'Soft band'],
  ['#0A0A0A', 'Text'],
  ['#4D4D4D', 'Secondary text'],
  ['#A6A6A6', 'Secondary on black'],
  ['#E6E6E6', 'Hairline'],
  ['#262626', 'Hairline on black'],
];
---

<Base title="Design System" description="The BizCare website's colours, type and components." noindex>
  <PageHero label="Preview Only" title="Design <span class='teal'>System</span>" line="Black, white and the logo's teal. Large type, full-width bands, real photos." />
  <section class="section">
    <div class="wrap stack">
      <h2 class="h3">Colours</h2>
      <ul class="swatches">
        {colours.map(([hex, name]) => (<li><span class="chip" style={`background:${hex}`} /><span class="small"><b>{name}</b><br /><code>{hex}</code></span></li>))}
      </ul>
      <h2 class="h3">Type</h2>
      <div class="stack-sm">
        <span class="eyebrow">Eyebrow</span>
        <p class="mega">Mega Headline</p>
        <p class="display">Display Headline</p>
        <p class="h2">Section Headline</p>
        <p class="h3">Card Title</p>
        <p class="statement">A statement paragraph <span class="quiet">with a quieter second half.</span></p>
        <p class="lede">A lede line in secondary text.</p>
        <p>Body text at 18 pixels with a line height of 1.6.</p>
      </div>
      <h2 class="h3">Buttons</h2>
      <div class="row">
        <a class="btn btn-teal" href="#">Book a Demo <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-line" href="#">See Our Work</a>
        <a class="btn btn-line" href="#"><Icon name="whatsapp-logo" class="wa" /> WhatsApp</a>
        <Sample />
        <a class="link" href="#">Text Link <Icon name="arrow-right" size={18} /></a>
      </div>
      <h2 class="h3">Numbers</h2>
      <Stats />
      <h2 class="h3">Numbered Items</h2>
      <Numbered items={[{ title: 'First', line: 'One plain line.' }, { title: 'Second', line: 'One plain line.' }, { title: 'Third', line: 'One plain line.' }]} />
      <h2 class="h3">Questions</h2>
      <Faq items={[{ q: 'A question?', a: 'Its answer, in plain words.' }, { q: 'Another question?', a: 'Another answer.' }]} />
    </div>
  </section>
  <section class="section dark">
    <div class="wrap stack">
      <Logo height={44} />
      <p class="display">On Black</p>
      <div class="row">
        <a class="btn btn-teal" href="#">Book a Demo</a>
        <a class="btn btn-line" href="#">See Our Work</a>
      </div>
      <WhatsAppMessage />
    </div>
  </section>
</Base>

<style>
  .stack { display: grid; gap: 24px; }
  .stack > :global(.h3) { margin-top: 32px; }
  .stack-sm { display: grid; gap: 14px; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
  .swatches li { display: flex; align-items: center; gap: 12px; }
  .chip { width: 52px; height: 52px; border-radius: 12px; border: 1px solid #ddd; flex: none; }
  code { font-size: 0.8125rem; color: var(--ink-3); }
</style>
