---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

/** How BizCare works with a new client. */
const steps: { icon: IconName; title: string; line: string }[] = [
  { icon: 'presentation-chart', title: 'Demo', line: 'See the software working for a business like yours, and ask anything.' },
  { icon: 'gear', title: 'Setup', line: 'We set it up around the way your business already works.' },
  { icon: 'chalkboard-teacher', title: 'Training', line: 'Your staff learn it with our team until they are comfortable.' },
  { icon: 'headset', title: 'Support', line: 'Call or WhatsApp us when you need help. 20,000+ hours so far.' },
];
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step card reveal">
        <div class="row">
          <span class="tile">
            <Icon name={s.icon} size={22} />
          </span>
          <span class="n num">0{i + 1}</span>
        </div>
        <h3 class="h3">{s.title}</h3>
        <p class="muted">{s.line}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    counter-reset: none;
  }
  .step { display: grid; align-content: start; gap: 10px; padding: 24px; }
  .row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .n { font-size: 0.875rem; font-weight: 800; color: var(--ink-3); letter-spacing: 0.04em; }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: minmax(0, 1fr); } }
</style>
