---
/** How BizCare works with a new client, as four numbered steps along a line. */
const steps = [
  { title: 'Demo', line: 'We show you the software working for a business like yours, and answer every question.' },
  { title: 'Setup', line: 'We set it up around the way your business already works, and move your records in.' },
  { title: 'Training', line: 'Your staff learn it with our team, at your place, until they are comfortable.' },
  { title: 'Support', line: 'Call or WhatsApp us whenever you need help. More than 20,000 hours of support so far.' },
];
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="step reveal">
        <span class="n num">0{i + 1}</span>
        <h3 class="h3">{s.title}</h3>
        <p class="muted">{s.line}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .step { display: grid; gap: 14px; align-content: start; padding-top: 28px; border-top: 2px solid var(--line); }
  .step:first-child { border-top-color: var(--teal); }
  .n {
    font-size: clamp(3rem, 2.4rem + 1.8vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--line-strong);
  }
  .step:first-child .n { color: var(--teal); }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 48px; } }
  @media (max-width: 560px) { .steps { grid-template-columns: minmax(0, 1fr); row-gap: 36px; } }
</style>
