---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

/**
 * A real screen in a plain frame drawn in CSS: a browser for web apps, a
 * window for desktop software, and for apps a Galaxy S-series phone (flat
 * sides, small corners, a centred punch-hole camera, side keys). The frame's
 * tint shows until the image arrives, and its size is reserved, so nothing
 * jumps.
 */
interface Props {
  kind: 'browser' | 'window' | 'phone';
  src: ImageMetadata;
  alt: string;
  /** Address in the browser bar, or the window's title. */
  title?: string;
  /** For the first screen a visitor sees: loads at once, at high priority. */
  priority?: boolean;
  /** How wide the frame shows, for picking the right image size. */
  sizes?: string;
  class?: string;
}

const { kind, src, alt, title, priority = false, sizes, class: className } = Astro.props;
const phone = kind === 'phone';
const widths = (phone ? [240, 360, 540, 720] : [480, 720, 960, 1280, 1600, 1920]).filter((w) => w <= src.width);
const fallbackSizes = phone ? '(max-width: 640px) 60vw, 300px' : '(max-width: 960px) 100vw, 640px';
---

<figure class:list={['frame', `frame-${kind}`, className]}>
  {
    kind === 'browser' && (
      <div class="chrome" aria-hidden="true">
        <span class="dots">
          <i />
          <i />
          <i />
        </span>
        <span class="address">{title}</span>
      </div>
    )
  }
  {
    kind === 'window' && (
      <div class="chrome" aria-hidden="true">
        <span class="title">{title}</span>
        <span class="controls">
          <i class="min" />
          <i class="max" />
          <i class="close" />
        </span>
      </div>
    )
  }
  <div class={phone ? 'device' : 'plain'}>
  {phone && <span class="keys" aria-hidden="true" />}
  <div class="screen" style={phone ? undefined : `aspect-ratio: ${src.width} / ${src.height}`}>
    {phone && <span class="camera" aria-hidden="true" />}
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes ?? fallbackSizes}
      quality={72}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  </div>
  </div>
</figure>

<style>
  .frame {
    margin: 0;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 16px;
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .dots { display: flex; gap: 6px; flex: none; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
  .address {
    flex: 1;
    min-width: 0;
    max-width: 360px;
    margin-inline: auto;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .frame-window .chrome { justify-content: space-between; height: 34px; }
  .title { font-size: 0.75rem; font-weight: 700; color: var(--ink-2); white-space: nowrap; }
  .controls { display: flex; gap: 16px; align-items: center; }
  .controls i { position: relative; width: 10px; height: 10px; }
  .controls .min::before { content: ''; position: absolute; left: 0; right: 0; top: 5px; height: 1.4px; background: var(--ink-3); }
  .controls .max { border: 1.4px solid var(--ink-3); border-radius: 1px; }
  .controls .close::before, .controls .close::after {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    top: 4px;
    height: 1.4px;
    background: var(--ink-3);
    transform: rotate(45deg);
  }
  .controls .close::after { transform: rotate(-45deg); }

  .screen { position: relative; background: var(--bg-soft); }
  .screen :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  /* The phone: a Galaxy S-series body. Sizes are in cqw (container width),
     so the frame keeps its proportions at any width. */
  .frame-phone {
    container-type: inline-size;
    overflow: visible;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }
  .plain { display: contents; }
  .device {
    position: relative;
    padding: 2.6cqw;
    border-radius: 6.2cqw;
    background: #0a0a0a;
    box-shadow:
      0 0 0 1.4px #4a4a4c,
      0 0 0 2.6px #1b1b1c,
      0 30px 60px -24px rgb(0 0 0 / 0.55);
  }
  .frame-phone .screen {
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border-radius: 3.8cqw;
    background: #111;
  }
  .camera {
    position: absolute;
    top: 2.6cqw;
    left: 50%;
    z-index: 2;
    width: 3.6cqw;
    height: 3.6cqw;
    border-radius: 50%;
    background: #050505;
    box-shadow: 0 0 0 0.5cqw rgb(0 0 0 / 0.65), inset 0 0 0 0.45cqw #1c1f24;
    transform: translateX(-50%);
  }
  /* Volume and power keys on the right edge. */
  .keys {
    position: absolute;
    right: -1.9cqw;
    top: 19%;
    width: 1.3cqw;
    height: 13%;
    border-radius: 0 2px 2px 0;
    background: #2c2c2e;
    box-shadow: 0 calc(13cqw * 2.6) 0 0 #2c2c2e;
  }
  @media (max-width: 640px) {
    .chrome { height: 30px; gap: 8px; padding: 0 10px; }
    .dots i { width: 7px; height: 7px; }
    .address { font-size: 0.6875rem; padding: 2px 10px; }
    .frame-window .chrome { height: 28px; }
    .controls { gap: 12px; }
    .controls i { width: 8px; height: 8px; }
    .controls .min::before { top: 4px; }
    .controls .close::before, .controls .close::after { top: 3px; }
  }
</style>
