---
import { getCollection } from 'astro:content';
import BrandIcon from './BrandIcon.astro';
import Logo from './Logo.astro';
import { company, whatsappHref } from '../data/site';
import { u } from '../lib/url';

/** A classic footer: who we are and how to reach us, four short columns, then the small print. */
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="wrap">
    <div class="cols">
      <div class="about">
        <a class="flogo" href={u('/')} aria-label="BizCare, home"><Logo height={30} /></a>
        <p class="tag">Business software and apps, built in Lahore and used every day by more than 300 businesses.</p>
        <a class="wa" href={whatsappHref()} target="_blank" rel="noopener">
          <BrandIcon name="whatsapp" size={20} /> Chat on WhatsApp
        </a>
      </div>

      <nav aria-label="Business software">
        <p class="col-title">Software</p>
        <ul class="col-links">
          {products.map((p) => <li><a href={u(`/products/${p.id}/`)}>{p.data.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Apps and services">
        <p class="col-title">Apps</p>
        <ul class="col-links">
          {apps.map((a) => <li><a href={u(`/apps/${a.id}/`)}>{a.data.name}</a></li>)}
        </ul>
        <p class="col-title gap">Services</p>
        <ul class="col-links">
          {services.map((s) => <li><a href={u(`/services/${s.id}/`)}>{s.data.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Company">
        <p class="col-title">Company</p>
        <ul class="col-links">
          <li><a href={u('/about/')}>About</a></li>
          <li><a href={u('/clients/')}>Clients</a></li>
          <li><a href={u('/careers/')}>Careers</a></li>
          <li><a href={u('/contact/')}>Book a Demo</a></li>
        </ul>
      </nav>

      <div>
        <p class="col-title">Contact</p>
        <ul class="col-links contact">
          <li><a class="num" href={company.phoneHref}>{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={company.mapsHref} target="_blank" rel="noopener">Al-Hamd Garden, Lahore</a></li>
        </ul>
      </div>
    </div>

    <div class="base">
      <p>© {year} {company.name}</p>
      <ul>
        <li><a href={u('/privacy/')}>Privacy</a></li>
        <li><a href={u('/terms/')}>Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 80px 0 0; border-top: 1px solid #1c1c1e; }
  .cols {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 64px;
  }
  .about { display: grid; gap: 18px; align-content: start; max-width: 340px; }
  .flogo { color: var(--white); width: max-content; }
  .tag { color: var(--d-ink-2); font-size: 0.9375rem; line-height: 1.6; }
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    height: 42px;
    padding: 0 16px 0 12px;
    border-radius: 999px;
    border: 1px solid #2c2c2e;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--white);
    transition: border-color 0.2s var(--ease);
  }
  .wa:hover { border-color: #5a5a5c; }
  .col-title { margin-bottom: 14px; font-size: 0.875rem; font-weight: 700; color: var(--white); }
  .col-title.gap { margin-top: 30px; }
  .col-links { display: grid; gap: 4px; }
  .col-links a {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    font-size: 0.9375rem;
    color: var(--d-ink-2);
    transition: color 0.2s var(--ease);
  }
  .col-links a:hover { color: var(--white); }
  .base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 22px 0 28px;
    border-top: 1px solid #1c1c1e;
    font-size: 0.8125rem;
    color: var(--d-ink-3);
  }
  .base ul { display: flex; gap: 22px; }
  .base a:hover { color: var(--white); }
  @media (max-width: 1080px) {
    .cols { grid-template-columns: 1fr 1fr 1fr; }
    .about { grid-column: 1 / -1; max-width: 460px; }
  }
  @media (max-width: 560px) {
    .footer { padding-top: 64px; }
    .cols { grid-template-columns: 1fr 1fr; gap: 36px 20px; }
  }
</style>
