---
import { getCollection } from 'astro:content';
import Frame from './Frame.astro';
import Icon from './Icon.astro';
import { u } from '../lib/url';

/**
 * Pick Your Business: a sliding switch across the industries. The panel
 * below slides to that product's real screen, one line, three highlights and
 * a link. Without scripts, every panel shows one after another.
 */
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---

<div class="switch" data-switch>
  <div class="tabs-scroll">
    <div class="tabs" role="tablist" aria-label="Pick your business" data-tabs>
      <span class="pill-bg" aria-hidden="true" data-pill></span>
      {
        products.map((p, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${p.id}`}
            aria-controls={`panel-${p.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab>
            <Icon name={p.data.icon} size={18} />
            {p.data.industry}
          </button>
        ))
      }
    </div>
  </div>

  <div class="panels">
    {
      products.map((p, i) => (
        <div
          class:list={['panel', `tint-${p.data.tint}`, { active: i === 0 }]}
          role="tabpanel"
          id={`panel-${p.id}`}
          aria-labelledby={`tab-${p.id}`}
          data-panel>
          <div class="text">
            <div class="badge">
              <span class="tile">
                <Icon name={p.data.icon} size={22} />
              </span>
              <span>
                <span class="pname">{p.data.name}</span>
                <span class="pind">For {p.data.industry}</span>
              </span>
            </div>
            <h3 class="h3 phead">{p.data.headline}</h3>
            <p class="muted">{p.data.tagline}</p>
            <ul class="hl">
              {p.data.highlights.map((h) => (
                <li>
                  <Icon name="check-circle" size={20} class="ok" />
                  {h}
                </li>
              ))}
            </ul>
            <a class="link" href={u(`/products/${p.id}/`)}>
              See {p.data.name} <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <Frame
            kind={p.data.screen.frame}
            src={p.data.screen.src}
            alt={p.data.screen.alt}
            title={p.data.screen.title}
            sizes="(max-width: 960px) 100vw, 680px"
            class="pframe"
          />
        </div>
      ))
    }
  </div>
</div>

<style>
  .tabs-scroll {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  .tabs-scroll::-webkit-scrollbar { display: none; }
  .tabs {
    position: relative;
    display: inline-flex;
    gap: 4px;
    padding: 5px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .pill-bg {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--ink);
    transition: transform 0.35s var(--ease), width 0.35s var(--ease);
    opacity: 0;
  }
  .tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 0.3s var(--ease);
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected='true'] { color: var(--page); }
  /* Until the script measures the pill, the chosen tab carries its own fill. */
  .tabs:not([data-ready]) .tab[aria-selected='true'] { background: var(--ink); }
  .tabs[data-ready] .pill-bg { opacity: 1; }

  .panels { margin-top: 40px; }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: center;
  }
  :global(.js) .panel:not(.active) { display: none; }
  :global(html:not(.js)) .tabs-scroll { display: none; }
  :global(html:not(.js)) .panel + .panel { margin-top: 64px; }
  .panel.enter-next { animation: from-right 0.42s var(--ease) both; }
  .panel.enter-prev { animation: from-left 0.42s var(--ease) both; }
  @keyframes from-right { from { opacity: 0; transform: translateX(28px); } }
  @keyframes from-left { from { opacity: 0; transform: translateX(-28px); } }

  .text { display: grid; gap: 16px; align-content: center; justify-items: start; }
  .badge { display: flex; align-items: center; gap: 12px; }
  .pname { display: block; font-weight: 800; font-size: 1.0625rem; line-height: 1.25; }
  .pind { display: block; font-size: 0.875rem; color: var(--ink-2); }
  .phead { font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem); letter-spacing: -0.02em; line-height: 1.2; font-weight: 800; }
  .hl { display: grid; gap: 10px; margin: 4px 0 6px; }
  .hl li { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; }
  .hl :global(.ok) { flex: none; margin-top: 2px; color: var(--t-fg); }

  @media (max-width: 960px) {
    .tabs-scroll { justify-content: flex-start; }
    .panel { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .panels { margin-top: 28px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-switch]').forEach((root) => {
    const tablist = root.querySelector<HTMLElement>('[data-tabs]')!;
    const pill = root.querySelector<HTMLElement>('[data-pill]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    let current = 0;

    const placePill = () => {
      const tab = tabs[current];
      pill.style.width = `${tab.offsetWidth}px`;
      pill.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const select = (next: number, focus = false) => {
      if (next === current) return;
      const dir = next > current ? 'enter-next' : 'enter-prev';
      tabs[current].setAttribute('aria-selected', 'false');
      tabs[current].tabIndex = -1;
      panels[current].classList.remove('active', 'enter-next', 'enter-prev');
      current = next;
      tabs[current].setAttribute('aria-selected', 'true');
      tabs[current].tabIndex = 0;
      const panel = panels[current];
      panel.classList.remove('enter-next', 'enter-prev');
      panel.classList.add('active', dir);
      placePill();
      tabs[current].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      if (focus) tabs[current].focus();
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
    tablist.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = {
        ArrowRight: current + 1,
        ArrowLeft: current - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select((keys[e.key] + tabs.length) % tabs.length, true);
    });

    // Place the pill without animating, then let it slide from then on.
    pill.style.transition = 'none';
    placePill();
    void pill.offsetWidth;
    pill.style.transition = '';
    tablist.setAttribute('data-ready', '');
    new ResizeObserver(placePill).observe(tablist);
    document.fonts?.ready.then(placePill);

    // Fetch the other screens once the switch is close, so each tap is instant.
    new IntersectionObserver(
      ([entry], io) => {
        if (!entry.isIntersecting) return;
        root.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
        io.disconnect();
      },
      { rootMargin: '400px 0px' },
    ).observe(root);
  });
</script>
