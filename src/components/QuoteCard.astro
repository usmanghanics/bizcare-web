---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Sample from './Sample.astro';

interface Props {
  quote: CollectionEntry<'quotes'>;
}
const { quote } = Astro.props;
const q = quote.data;
const initials = q.name
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<figure class="quote card reveal">
  <div class="top">
    <Icon name="quotes" size={28} class="mark" />
    <Sample when={q.sample} />
  </div>
  <blockquote>
    <p>{q.text}</p>
  </blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{initials}</span>
    <span>
      <span class="who">{q.name}</span>
      <span class="where">{q.role}, {q.business}, {q.town}</span>
    </span>
  </figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 28px;
  }
  .top { display: flex; justify-content: space-between; align-items: flex-start; }
  .top :global(.mark) { color: var(--accent); }
  blockquote { margin: 0; flex: 1; }
  blockquote p { font-size: 1.125rem; line-height: 1.55; font-weight: 600; color: var(--ink); }
  figcaption { display: flex; align-items: center; gap: 12px; padding-top: 18px; border-top: 1px solid var(--line); }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 800;
  }
  .who { display: block; font-weight: 750; line-height: 1.3; }
  .where { display: block; font-size: 0.875rem; line-height: 1.4; color: var(--ink-2); }
</style>
