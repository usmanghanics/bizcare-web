---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { company, whatsappHref } from '../data/site';
import { isCurrent, u } from '../lib/url';

const path = Astro.url.pathname;
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const links = [
  { href: '/clients/', label: 'Clients' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const inProducts = ['/products/', '/apps/', '/services/'].some((p) => isCurrent(path, p));
---

<div class="top-sentinel" data-top-sentinel aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="shell">
    <div class="bar">
      <a class="brand" href={u('/')} aria-label="BizCare, home">
        <Logo height={30} />
      </a>

      <nav class="nav" aria-label="Main">
        <ul class="nav-list">
          <li class="has-menu" data-menu-root>
            <button
              class="nav-link"
              type="button"
              aria-expanded="false"
              aria-controls="menu-products"
              aria-current={inProducts ? 'page' : undefined}
              data-menu-button>
              Products <Icon name="caret-down" size={14} class="caret" />
            </button>
            <div class="menu card" id="menu-products" data-menu hidden>
              <div class="menu-cols">
                <div>
                  <p class="menu-title">Business Software</p>
                  <ul class="menu-list">
                    {
                      products.map((p) => (
                        <li>
                          <a class:list={['menu-item', `tint-${p.data.tint}`]} href={u(`/products/${p.id}/`)}>
                            <span class="tile tile-sm">
                              <Icon name={p.data.icon} size={18} />
                            </span>
                            <span>
                              <span class="menu-name">{p.data.name}</span>
                              <span class="menu-line">{p.data.industry}</span>
                            </span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <div>
                  <p class="menu-title">Apps</p>
                  <ul class="menu-list">
                    {
                      apps.map((a) => (
                        <li>
                          <a class:list={['menu-item', `tint-${a.data.tint}`]} href={u(`/apps/${a.id}/`)}>
                            <span class="tile tile-sm">
                              <Icon name={a.data.icon} size={18} />
                            </span>
                            <span>
                              <span class="menu-name">{a.data.name}</span>
                              <span class="menu-line">{a.data.kind === 'own' ? 'Our own app' : `For ${a.data.client}`}</span>
                            </span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                  <p class="menu-title menu-title-gap">Services</p>
                  <ul class="menu-list">
                    {
                      services.map((s) => (
                        <li>
                          <a class="menu-item" href={u(`/services/${s.id}/`)}>
                            <span class="tile tile-sm">
                              <Icon name={s.data.icon} size={18} />
                            </span>
                            <span>
                              <span class="menu-name">{s.data.name}</span>
                            </span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
              <a class="menu-foot link" href={u('/products/')}>
                See All Products <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </li>
          {
            links.map((l) => (
              <li>
                <a class="nav-link" href={u(l.href)} aria-current={isCurrent(path, l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="actions">
        <a
          class="btn btn-quiet btn-sm wa-btn"
          href={whatsappHref()}
          target="_blank"
          rel="noopener"
          aria-label="Chat with BizCare on WhatsApp">
          <Icon name="whatsapp-logo" size={20} class="wa" />
          <span class="wa-text">WhatsApp</span>
        </a>
        <button class="btn btn-quiet btn-sm btn-icon theme-btn" type="button" data-theme-toggle aria-label="Use dark theme">
          <Icon name="moon" size={18} class="to-dark" />
          <Icon name="sun" size={18} class="to-light" />
        </button>
        <a class="btn btn-primary btn-sm demo-btn" href={u('/contact/')}>Book a Demo</a>
        <button
          class="btn btn-quiet btn-sm btn-icon sheet-btn"
          type="button"
          aria-expanded="false"
          aria-controls="sheet"
          aria-label="Open menu"
          data-sheet-button>
          <Icon name="list" size={20} class="open-icon" />
          <Icon name="x" size={20} class="close-icon" />
        </button>
      </div>
    </div>
  </div>

  <div class="sheet" id="sheet" data-sheet hidden>
    <div class="sheet-inner wrap">
      <p class="menu-title">Business Software</p>
      <ul class="sheet-grid">
        {
          products.map((p) => (
            <li>
              <a class:list={['menu-item', `tint-${p.data.tint}`]} href={u(`/products/${p.id}/`)}>
                <span class="tile tile-sm">
                  <Icon name={p.data.icon} size={18} />
                </span>
                <span>
                  <span class="menu-name">{p.data.name}</span>
                  <span class="menu-line">{p.data.industry}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="menu-title">Apps and Services</p>
      <ul class="sheet-grid">
        {
          apps.map((a) => (
            <li>
              <a class:list={['menu-item', `tint-${a.data.tint}`]} href={u(`/apps/${a.id}/`)}>
                <span class="tile tile-sm">
                  <Icon name={a.data.icon} size={18} />
                </span>
                <span class="menu-name">{a.data.name}</span>
              </a>
            </li>
          ))
        }
        {
          services.map((s) => (
            <li>
              <a class="menu-item" href={u(`/services/${s.id}/`)}>
                <span class="tile tile-sm">
                  <Icon name={s.data.icon} size={18} />
                </span>
                <span class="menu-name">{s.data.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="sheet-links">
        <li><a href={u('/products/')}>All Products</a></li>
        <li><a href={u('/clients/')}>Clients</a></li>
        <li><a href={u('/about/')}>About</a></li>
        <li><a href={u('/careers/')}>Careers</a></li>
        <li><a href={u('/contact/')}>Contact</a></li>
      </ul>
      <div class="sheet-actions">
        <a class="btn btn-primary" href={u('/contact/')}>Book a Demo</a>
        <div class="sheet-pair">
          <a class="btn btn-quiet" href={whatsappHref()} target="_blank" rel="noopener">
            <Icon name="whatsapp-logo" class="wa" /> WhatsApp
          </a>
          <a class="btn btn-quiet" href={company.phoneHref}>
            <Icon name="phone" /> Call
          </a>
        </div>
        <button class="btn btn-quiet sheet-theme" type="button" data-theme-toggle aria-label="Use dark theme">
          <Icon name="moon" size={18} class="to-dark" />
          <Icon name="sun" size={18} class="to-light" />
          <span class="to-dark">Dark Theme</span>
          <span class="to-light">Light Theme</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .top-sentinel { position: absolute; top: 0; left: 0; height: 12px; width: 1px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--bar);
  }
  .shell {
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--bar);
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--page);
    transition:
      height 0.3s var(--ease),
      margin 0.3s var(--ease),
      padding 0.3s var(--ease),
      border-radius 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  /* After scrolling: a floating rounded bar with a hairline and one soft shadow. */
  .site-header[data-scrolled] .bar {
    height: 60px;
    margin-top: 10px;
    padding: 0 10px 0 20px;
    border-color: var(--line);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }
  .site-header[data-open] .bar {
    height: var(--bar);
    margin-top: 0;
    padding: 0;
    border-color: transparent;
    border-radius: 0;
    background: var(--page);
    box-shadow: none;
  }

  .brand { display: flex; align-items: center; min-height: 44px; flex: none; }

  .nav { margin-right: auto; }
  .nav-list { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--ink-2);
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav-link:hover, .nav-link[aria-expanded='true'] { color: var(--ink); background: var(--surface-2); }
  .nav-link[aria-current='page'] { color: var(--ink); }
  .nav-link :global(.caret) { transition: transform 0.25s var(--ease); }
  .nav-link[aria-expanded='true'] :global(.caret) { transform: rotate(180deg); }

  .has-menu { position: relative; }
  .menu {
    position: absolute;
    top: calc(100% + 12px);
    left: -12px;
    width: 640px;
    padding: 20px;
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .menu[data-shown] { opacity: 1; transform: none; }
  .menu-cols { display: grid; grid-template-columns: 1.15fr 1fr; gap: 12px; }
  .menu-title {
    padding: 0 10px 8px;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .menu-title-gap { margin-top: 14px; }
  .menu-list { display: grid; gap: 2px; }
  .menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 6px 10px;
    border-radius: 12px;
    transition: background-color 0.2s var(--ease);
  }
  .menu-item:hover { background: var(--surface-2); }
  .menu-name { display: block; font-size: 0.9375rem; font-weight: 700; line-height: 1.3; color: var(--ink); }
  .menu-line { display: block; font-size: 0.8125rem; line-height: 1.35; color: var(--ink-2); }
  .menu-foot {
    margin-top: 14px;
    padding: 14px 10px 0;
    border-top: 1px solid var(--line);
    display: flex;
    font-size: 0.9375rem;
  }

  .actions { display: flex; align-items: center; gap: 8px; }
  .wa-btn :global(.wa) { color: var(--whatsapp); }
  .theme-btn :global(.to-light), .sheet-theme :global(.to-light) { display: none; }
  :global([data-theme='dark']) .theme-btn :global(.to-dark),
  :global([data-theme='dark']) .sheet-theme :global(.to-dark) { display: none; }
  :global([data-theme='dark']) .theme-btn :global(.to-light),
  :global([data-theme='dark']) .sheet-theme :global(.to-light) { display: inline; }
  .sheet-btn { display: none; }
  .sheet-btn :global(.close-icon) { display: none; }
  .sheet-btn[aria-expanded='true'] :global(.open-icon) { display: none; }
  .sheet-btn[aria-expanded='true'] :global(.close-icon) { display: block; }

  /* The phone menu. */
  .sheet {
    position: fixed;
    inset: var(--bar) 0 0;
    z-index: 49;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--page);
    border-top: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }
  .sheet[data-shown] { opacity: 1; }
  .sheet-inner { padding-top: 20px; padding-bottom: 40px; display: grid; gap: 10px; }
  .sheet .menu-title { padding: 10px 0 2px; }
  .sheet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 8px; }
  .sheet-grid .menu-item { padding: 6px 8px 6px 0; }
  .sheet-links { display: grid; margin-top: 12px; border-top: 1px solid var(--line); }
  .sheet-links a {
    display: flex;
    align-items: center;
    min-height: 54px;
    border-bottom: 1px solid var(--line);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .sheet-actions { display: grid; gap: 10px; margin-top: 18px; }
  .sheet-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sheet-actions :global(.wa) { color: var(--whatsapp); }

  @media (max-width: 1060px) {
    .nav, .theme-btn { display: none; }
    .actions { margin-left: auto; }
    .sheet-btn { display: inline-flex; }
    .wa-text { display: none; }
    .wa-btn { width: 44px; padding: 0; }
  }
  @media (min-width: 1061px) {
    .sheet { display: none; }
  }
  @media (max-width: 560px) {
    .demo-btn { display: none; }
    .site-header[data-scrolled] .bar { padding: 0 6px 0 16px; }
  }
  @media (max-width: 360px) {
    .sheet-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const root = document.documentElement;

  // Floating bar once the page moves.
  const sentinel = document.querySelector('[data-top-sentinel]');
  if (sentinel) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  // Theme: light by default, the choice is remembered on this device.
  const labelTheme = () => {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0a1113' : '#ffffff');
  };
  labelTheme();
  document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      if (dark) root.dataset.theme = 'dark';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
      labelTheme();
    }),
  );

  // Products menu: click or keyboard, plus hover where there is a mouse.
  const menuRoot = document.querySelector<HTMLElement>('[data-menu-root]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  let closeTimer = 0;
  const setMenu = (open: boolean) => {
    if (!menu || !menuButton) return;
    window.clearTimeout(closeTimer);
    menuButton.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.hidden = false;
      void menu.offsetWidth; // apply the hidden state first, so the fade runs
      menu.setAttribute('data-shown', '');
    } else {
      menu.removeAttribute('data-shown');
      closeTimer = window.setTimeout(() => (menu.hidden = true), 200);
    }
  };
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  if (menuRoot && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let hoverTimer = 0;
    menuRoot.addEventListener('pointerenter', () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setMenu(true), 80);
    });
    menuRoot.addEventListener('pointerleave', () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setMenu(false), 160);
    });
  }
  document.addEventListener('click', (e) => {
    if (menuRoot && !menuRoot.contains(e.target as Node)) setMenu(false);
  });
  menuRoot?.addEventListener('focusout', (e) => {
    if (!menuRoot.contains(e.relatedTarget as Node)) setMenu(false);
  });

  // Phone menu.
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  const sheetButton = document.querySelector<HTMLButtonElement>('[data-sheet-button]');
  const setSheet = (open: boolean) => {
    if (!sheet || !sheetButton) return;
    sheetButton.setAttribute('aria-expanded', String(open));
    sheetButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header.toggleAttribute('data-open', open);
    root.style.overflow = open ? 'hidden' : '';
    if (open) {
      sheet.hidden = false;
      void sheet.offsetWidth;
      sheet.setAttribute('data-shown', '');
    } else {
      sheet.removeAttribute('data-shown');
      window.setTimeout(() => (sheet.hidden = true), 200);
    }
  };
  sheetButton?.addEventListener('click', () => setSheet(sheetButton.getAttribute('aria-expanded') !== 'true'));
  matchMedia('(min-width: 1061px)').addEventListener('change', (e) => e.matches && setSheet(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
    if (sheetButton?.getAttribute('aria-expanded') === 'true') {
      setSheet(false);
      sheetButton.focus();
    }
  });
</script>
