---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { company, whatsappHref } from '../data/site';
import { isCurrent, u } from '../lib/url';

const path = Astro.url.pathname;
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const links = [
  { href: '/clients/', label: 'Clients' },
  { href: '/about/', label: 'About' },
  { href: '/careers/', label: 'Careers' },
  { href: '/contact/', label: 'Contact' },
];
const inProducts = ['/products/', '/apps/', '/services/'].some((p) => isCurrent(path, p));
---

<header class="site-header" data-header>
  <div class="bar wrap">
    <a class="brand" href={u('/')} aria-label="BizCare, home"><Logo height={30} /></a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        <li class="has-menu" data-menu-root>
          <button
            class="nav-link"
            type="button"
            aria-expanded="false"
            aria-controls="menu-products"
            aria-current={inProducts ? 'page' : undefined}
            data-menu-button>
            Products <Icon name="caret-down" size={14} class="caret" />
          </button>
          <div class="menu" id="menu-products" data-menu hidden>
            <div class="menu-cols">
              <div>
                <p class="menu-title">Business Software</p>
                <ul class="menu-list">
                  {
                    products.map((p) => (
                      <li>
                        <a class="menu-item" href={u(`/products/${p.id}/`)}>
                          <span class="menu-icon"><Icon name={p.data.icon} size={20} /></span>
                          <span>
                            <span class="menu-name">{p.data.name}</span>
                            <span class="menu-line">{p.data.industry}</span>
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div>
                <p class="menu-title">Apps</p>
                <ul class="menu-list">
                  {
                    apps.map((a) => (
                      <li>
                        <a class="menu-item" href={u(`/apps/${a.id}/`)}>
                          <span class="menu-icon"><Icon name={a.data.icon} size={20} /></span>
                          <span>
                            <span class="menu-name">{a.data.name}</span>
                            <span class="menu-line">{a.data.kind === 'own' ? 'Our own app' : `For ${a.data.client}`}</span>
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <p class="menu-title gap">Services</p>
                <ul class="menu-list">
                  {
                    services.map((s) => (
                      <li>
                        <a class="menu-item" href={u(`/services/${s.id}/`)}>
                          <span class="menu-icon"><Icon name={s.data.icon} size={20} /></span>
                          <span class="menu-name">{s.data.name}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
            <a class="menu-foot" href={u('/products/')}>
              <span>See All Products</span>
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </li>
        {
          links.map((l) => (
            <li>
              <a class="nav-link" href={u(l.href)} aria-current={isCurrent(path, l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn" href={whatsappHref()} target="_blank" rel="noopener" aria-label="Chat with BizCare on WhatsApp">
        <Icon name="whatsapp-logo" size={20} />
      </a>
      <a class="btn btn-teal btn-sm demo" href={u('/contact/')}>Book a Demo</a>
      <button
        class="icon-btn sheet-btn"
        type="button"
        aria-expanded="false"
        aria-controls="sheet"
        aria-label="Open menu"
        data-sheet-button>
        <Icon name="list" size={22} class="open-icon" />
        <Icon name="x" size={22} class="close-icon" />
      </button>
    </div>
  </div>

  <div class="sheet" id="sheet" data-sheet hidden>
    <div class="sheet-inner wrap">
      <ul class="sheet-links">
        <li><a href={u('/products/')}>Products</a></li>
        <li><a href={u('/clients/')}>Clients</a></li>
        <li><a href={u('/about/')}>About</a></li>
        <li><a href={u('/careers/')}>Careers</a></li>
        <li><a href={u('/contact/')}>Contact</a></li>
      </ul>
      <p class="menu-title">Business Software</p>
      <ul class="sheet-grid">
        {
          products.map((p) => (
            <li>
              <a href={u(`/products/${p.id}/`)}>
                <span class="sname">{p.data.name}</span>
                <span class="sline">{p.data.industry}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="menu-title">Apps and Services</p>
      <ul class="sheet-grid">
        {
          apps.map((a) => (
            <li>
              <a href={u(`/apps/${a.id}/`)}>
                <span class="sname">{a.data.name}</span>
                <span class="sline">{a.data.kind === 'own' ? 'Our own app' : 'Client app'}</span>
              </a>
            </li>
          ))
        }
        {
          services.map((s) => (
            <li>
              <a href={u(`/services/${s.id}/`)}>
                <span class="sname">{s.data.name}</span>
                <span class="sline">Service</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sheet-actions">
        <a class="btn btn-teal" href={u('/contact/')}>Book a Demo</a>
        <div class="pair">
          <a class="btn btn-line" href={whatsappHref()} target="_blank" rel="noopener"><Icon name="whatsapp-logo" class="wa" /> WhatsApp</a>
          <a class="btn btn-line" href={company.phoneHref}><Icon name="phone" /> Call</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--white);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled],
  .site-header[data-open] {
    background: rgb(0 0 0 / 0.92);
    border-bottom-color: #1f1f1f;
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
  }
  /* A blur would make the header the frame for the fixed menu sheet, so drop it while the sheet is open. */
  .site-header[data-open] {
    background: var(--black);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .bar { display: flex; align-items: center; gap: 40px; height: var(--bar); }
  .brand { display: flex; align-items: center; min-height: 44px; flex: none; color: var(--white); }

  .nav { margin-right: auto; }
  .nav-list { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #cfcfcf;
    transition: color 0.2s var(--ease);
  }
  .nav-link:hover, .nav-link[aria-expanded='true'], .nav-link[aria-current='page'] { color: var(--white); }
  .nav-link :global(.caret) { transition: transform 0.25s var(--ease); }
  .nav-link[aria-expanded='true'] :global(.caret) { transform: rotate(180deg); }

  .has-menu { position: relative; }
  .menu {
    position: absolute;
    top: calc(100% + 14px);
    left: -20px;
    width: 720px;
    padding: 28px;
    border: 1px solid #262626;
    border-radius: var(--radius);
    background: #0b0b0b;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .menu[data-shown] { opacity: 1; transform: none; }
  .menu-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .menu-title {
    margin-bottom: 10px;
    padding-left: 12px;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .menu-title.gap { margin-top: 20px; }
  .menu-list { display: grid; gap: 2px; }
  .menu-item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    padding: 6px 12px;
    border-radius: 12px;
    transition: background-color 0.2s var(--ease);
  }
  .menu-item:hover { background: #171717; }
  .menu-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid #2a2a2a;
    color: var(--teal-bright);
  }
  .menu-name { display: block; font-size: 0.9375rem; font-weight: 700; line-height: 1.3; color: var(--white); }
  .menu-line { display: block; font-size: 0.8125rem; color: #9a9a9a; }
  .menu-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding: 16px 12px 0;
    border-top: 1px solid #222;
    font-weight: 700;
  }
  .menu-foot:hover { color: var(--teal-bright); }

  .actions { display: flex; align-items: center; gap: 10px; }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid #333;
    color: var(--white);
    transition: border-color 0.2s var(--ease);
  }
  .icon-btn:hover { border-color: #777; }
  .sheet-btn { display: none; }
  .sheet-btn :global(.close-icon) { display: none; }
  .sheet-btn[aria-expanded='true'] :global(.open-icon) { display: none; }
  .sheet-btn[aria-expanded='true'] :global(.close-icon) { display: block; }

  .sheet {
    position: fixed;
    inset: var(--bar) 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--black);
    border-top: 1px solid #1f1f1f;
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }
  .sheet[data-shown] { opacity: 1; }
  .sheet-inner { padding-top: 12px; padding-bottom: 40px; display: grid; gap: 12px; }
  .sheet-links a {
    display: flex;
    align-items: center;
    min-height: 64px;
    border-bottom: 1px solid #1f1f1f;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .sheet .menu-title { padding: 18px 0 2px; }
  .sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; }
  .sheet-grid a { display: grid; padding: 8px 0; min-height: 52px; align-content: center; }
  .sname { font-weight: 700; line-height: 1.3; }
  .sline { font-size: 0.8125rem; color: #9a9a9a; }
  .sheet-actions { display: grid; gap: 10px; margin-top: 20px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sheet .btn-line { border-color: #333; color: var(--white); }
  .sheet :global(.wa) { color: #3ccf73; }

  @media (max-width: 1080px) {
    .nav { display: none; }
    .actions { margin-left: auto; }
    .sheet-btn { display: inline-grid; }
  }
  @media (min-width: 1081px) {
    .sheet { display: none; }
  }
  @media (max-width: 560px) {
    .demo { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const root = document.documentElement;

  // A solid bar once the page moves.
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Products menu: click or keyboard, plus hover where there is a mouse.
  const menuRoot = document.querySelector<HTMLElement>('[data-menu-root]');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  let closeTimer = 0;
  const setMenu = (open: boolean) => {
    if (!menu || !menuButton) return;
    window.clearTimeout(closeTimer);
    menuButton.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.hidden = false;
      void menu.offsetWidth;
      menu.setAttribute('data-shown', '');
    } else {
      menu.removeAttribute('data-shown');
      closeTimer = window.setTimeout(() => (menu.hidden = true), 200);
    }
  };
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  if (menuRoot && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let hoverTimer = 0;
    menuRoot.addEventListener('pointerenter', () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setMenu(true), 80);
    });
    menuRoot.addEventListener('pointerleave', () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setMenu(false), 180);
    });
  }
  document.addEventListener('click', (e) => {
    if (menuRoot && !menuRoot.contains(e.target as Node)) setMenu(false);
  });
  menuRoot?.addEventListener('focusout', (e) => {
    if (!menuRoot.contains(e.relatedTarget as Node)) setMenu(false);
  });

  // Phone menu.
  const sheet = document.querySelector<HTMLElement>('[data-sheet]');
  const sheetButton = document.querySelector<HTMLButtonElement>('[data-sheet-button]');
  const setSheet = (open: boolean) => {
    if (!sheet || !sheetButton) return;
    sheetButton.setAttribute('aria-expanded', String(open));
    sheetButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header.toggleAttribute('data-open', open);
    root.style.overflow = open ? 'hidden' : '';
    if (open) {
      sheet.hidden = false;
      void sheet.offsetWidth;
      sheet.setAttribute('data-shown', '');
    } else {
      sheet.removeAttribute('data-shown');
      window.setTimeout(() => (sheet.hidden = true), 200);
    }
  };
  sheetButton?.addEventListener('click', () => setSheet(sheetButton.getAttribute('aria-expanded') !== 'true'));
  matchMedia('(min-width: 1081px)').addEventListener('change', (e) => e.matches && setSheet(false));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
    if (sheetButton?.getAttribute('aria-expanded') === 'true') {
      setSheet(false);
      sheetButton.focus();
    }
  });
</script>
