---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import type { IconName } from '../lib/icons';
import { u } from '../lib/url';

/** WhatsApp alerts, shown once for every product instead of on each one. */
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const messages: { icon: IconName; kind: string; text: string; time: string }[] = [
  { icon: 'receipt', kind: 'Invoice', text: 'Invoice INV-2041 for Rs 59,500 is ready. Thank you for your order.', time: '10:42' },
  { icon: 'clock', kind: 'Payment Due', text: 'A reminder that Rs 59,500 is due on 30 October.', time: '09:00' },
  { icon: 'check-circle', kind: 'Receipt', text: 'Payment of Rs 59,500 received. Your balance is now Rs 0.', time: '16:15' },
  { icon: 'bank', kind: 'Bank Transfer', text: 'Bank transfer of Rs 25,000 received. Thank you.', time: '11:30' },
];
---

<section class="section band" aria-labelledby="wa-title">
  <div class="wrap wa-grid">
    <div class="wa-copy">
      <SectionHead
        id="wa-title"
        label="WhatsApp Alerts"
        title="Every Bill Reaches Your Customer on WhatsApp"
        line="Invoices, payment reminders, receipts and bank transfers go out on their own, from every BizCare product."
      />
      <div class="works reveal">
        <p class="tiny works-title">Built into</p>
        <ul class="chips">
          {
            products.map((p) => (
              <li>
                <a class:list={['chip', `tint-${p.data.tint}`]} href={u(`/products/${p.id}/`)}>
                  <span class="tile tile-sm">
                    <Icon name={p.data.icon} size={16} />
                  </span>
                  {p.data.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="link" href={u('/services/whatsapp-cloud-api/')}>
          How It Works <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>

    <div class="chat card reveal" role="img" aria-label="Examples of the WhatsApp messages customers receive">
      <div class="chat-head" aria-hidden="true">
        <span class="chat-avatar"><Icon name="storefront" size={18} /></span>
        <span>
          <span class="chat-name">Your Business</span>
          <span class="chat-sub">Sent automatically</span>
        </span>
        <Icon name="whatsapp-logo" size={22} class="chat-wa" />
      </div>
      <ul class="chat-body" aria-hidden="true">
        {
          messages.map((m) => (
            <li class="bubble">
              <span class="kind">
                <Icon name={m.icon} size={14} /> {m.kind}
              </span>
              <span class="btext">{m.text}</span>
              <span class="time">{m.time}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .wa-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
    gap: 64px;
    align-items: center;
  }
  .wa-copy { display: grid; gap: 32px; }
  .wa-copy :global(.head + *) { margin-top: 0; }
  .works { display: grid; gap: 14px; justify-items: start; }
  .works-title { font-weight: 750; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 4px 14px 4px 4px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 700;
    transition: border-color 0.2s var(--ease);
  }
  .chip:hover { border-color: var(--line-strong); }
  .chip .tile { border-radius: 50%; }

  .chat { overflow: hidden; }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
  }
  .chat-avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent-ink);
  }
  .chat-name { display: block; font-weight: 800; line-height: 1.25; }
  .chat-sub { display: block; font-size: 0.8125rem; color: var(--ink-2); }
  .chat-head :global(.chat-wa) { margin-left: auto; color: var(--whatsapp); }
  .chat-body {
    display: grid;
    gap: 10px;
    padding: 18px;
    background: var(--surface-2);
  }
  .bubble {
    position: relative;
    display: grid;
    gap: 4px;
    max-width: 92%;
    padding: 10px 14px 20px;
    border-radius: 4px 16px 16px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .btext { font-size: 0.9375rem; line-height: 1.45; }
  .time { position: absolute; right: 12px; bottom: 6px; font-size: 0.6875rem; color: var(--ink-3); }

  @media (max-width: 960px) {
    .wa-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .chat { max-width: 480px; }
  }
</style>
