---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';

/**
 * Real photos of the BizCare team with clients at their mills, drifting in
 * three columns on a laptop and two rows on a phone. Each column holds its
 * photos twice, so the loop has no seam. Still when Reduce Motion is on.
 */
const clients = (await getCollection('clients'))
  .filter((c) => c.data.photo)
  .sort((a, b) => b.data.since.localeCompare(a.data.since));

// Spread across regions: the newest from each region first, then the next.
const picked: typeof clients = [];
const seen = new Map<string, number>();
for (const round of [0, 1, 2]) {
  for (const c of clients) {
    const n = seen.get(c.data.region.id) ?? 0;
    if (n === round && picked.length < 15 && !picked.includes(c)) {
      picked.push(c);
      seen.set(c.data.region.id, n + 1);
    }
  }
}
const columns = [0, 1, 2].map((k) => picked.filter((_, i) => i % 3 === k));
---

<div class="mosaic" aria-hidden="true">
  {
    columns.map((col, k) => (
      <div class:list={['col', `c${k}`]}>
        <div class="track">
          {[...col, ...col].map((c, i) => (
            <figure class="tile">
              <Picture
                src={c.data.photo!}
                alt=""
                formats={['avif', 'webp']}
                widths={[280, 420, 560]}
                sizes="(max-width: 960px) 200px, 260px"
                quality={64}
                loading={i < 2 && k < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption>{c.data.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    height: clamp(560px, 78vh, 760px);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
  }
  .col { overflow: hidden; }
  .track {
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: up 70s linear infinite;
  }
  .c1 .track { animation-name: down; animation-duration: 84s; }
  .c2 .track { animation-duration: 76s; }
  .tile {
    position: relative;
    aspect-ratio: 4 / 5;
    flex: none;
    overflow: hidden;
    border-radius: 18px;
    background: #141414;
  }
  .tile :global(picture), .tile :global(img) { width: 100%; height: 100%; }
  .tile :global(img) { object-fit: cover; object-position: center 40%; }
  figcaption {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.62);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 650;
    white-space: nowrap;
  }
  @keyframes up { from { transform: translateY(0); } to { transform: translateY(calc(-50% - 8px)); } }
  @keyframes down { from { transform: translateY(calc(-50% - 8px)); } to { transform: translateY(0); } }
  @keyframes left { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 6px)); } }
  @keyframes right { from { transform: translateX(calc(-50% - 6px)); } to { transform: translateX(0); } }

  @media (max-width: 960px) {
    .mosaic {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 168px;
      gap: 12px;
      height: auto;
      margin-inline: calc(-1 * var(--gutter));
      -webkit-mask-image: none;
      mask-image: none;
    }
    .c2 { display: none; }
    .track { flex-direction: row; gap: 12px; height: 100%; animation-name: left; animation-duration: 60s; }
    .c1 .track { animation-name: right; animation-duration: 66s; }
    .tile { aspect-ratio: 4 / 3; height: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
</style>
