---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import { u } from '../lib/url';

/**
 * Our team at client mills, as a slowly drifting wall of photos.
 *
 * Laptop: three straight columns drifting at their own pace. The wall
 * slows right down while the pointer is on it, the photo under the pointer
 * lifts, and a click opens that region's clients.
 * Phone: two rows that drift and can be swiped by hand.
 * Each photo carries its mill's name and town inside its own bottom edge,
 * so a caption is never pushed out or cut off. Still with Reduce Motion.
 */
const clients = (await getCollection('clients'))
  .filter((c) => c.data.photo)
  .sort((a, b) => b.data.since.localeCompare(a.data.since));

// Spread across regions: the newest from each region first, then the next.
const picked: typeof clients = [];
const seen = new Map<string, number>();
for (const round of [0, 1, 2]) {
  for (const c of clients) {
    const n = seen.get(c.data.region.id) ?? 0;
    if (n === round && picked.length < 18 && !picked.includes(c)) {
      picked.push(c);
      seen.set(c.data.region.id, n + 1);
    }
  }
}
const columns = [0, 1, 2].map((k) => picked.filter((_, i) => i % 3 === k));
const speeds = [22, 30, 26]; // pixels per second, each column its own pace
---

<div class="mosaic" data-mosaic>
  <div class="stage" data-stage>
    {
      columns.map((col, k) => (
        <div class:list={['col', `c${k}`]} data-col data-speed={speeds[k]} data-dir={k === 1 ? -1 : 1}>
          <div class="track" data-track>
            {[0, 1].map((copy) =>
              col.map((c, i) => (
                <a
                  class="tile"
                  href={u(`/clients/?region=${c.data.region.id}`)}
                  aria-hidden={copy === 1 ? 'true' : undefined}
                  tabindex={copy === 1 ? -1 : undefined}>
                  <Picture
                    src={c.data.photo!}
                    alt={copy === 0 ? `${c.data.name}, ${c.data.town}` : ''}
                    formats={['avif', 'webp']}
                    widths={[300, 450, 600]}
                    sizes="(max-width: 960px) 220px, 240px"
                    quality={64}
                    loading={copy === 0 && i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="cap">
                    <span class="cap-name">{c.data.name}</span>
                    <span class="cap-town">{c.data.town}</span>
                  </span>
                </a>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .mosaic {
    position: relative;
    height: clamp(560px, 76vh, 760px);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }
  .stage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    height: 100%;
  }
  .c1 { margin-top: -60px; }
  .col { overflow: hidden; }
  .track { display: flex; flex-direction: column; gap: 14px; will-change: transform; }
  .tile {
    position: relative;
    display: block;
    flex: none;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    background: #141414;
    transition: transform 0.45s var(--ease), opacity 0.45s var(--ease), filter 0.45s var(--ease);
  }
  .tile :global(picture), .tile :global(img) { width: 100%; height: 100%; }
  .tile :global(img) { object-fit: cover; object-position: center 40%; }
  .cap {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 1px;
    padding: 36px 12px 11px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0));
    color: #fff;
  }
  .cap-name {
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cap-town { font-size: 0.71875rem; color: rgb(255 255 255 / 0.7); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Pointer on the wall: everything quietens, the photo under it lifts. */
  .mosaic[data-hover] .tile { opacity: 0.62; filter: saturate(0.8); }
  .mosaic[data-hover] .tile:hover { opacity: 1; filter: none; transform: scale(1.03); }
  .tile:focus-visible { outline: 2px solid var(--teal-bright); outline-offset: 2px; }

  @media (max-width: 960px) {
    .mosaic {
      height: auto;
      perspective: none;
      margin-inline: calc(-1 * var(--gutter));
      -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    }
    .stage { grid-template-columns: minmax(0, 1fr); grid-auto-rows: 200px; height: auto; gap: 12px; }
    .c1 { margin-top: 0; }
    .c2 { display: none; }
    .col { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .col::-webkit-scrollbar { display: none; }
    .track { flex-direction: row; gap: 12px; height: 100%; width: max-content; padding-inline: var(--gutter); }
    .tile { aspect-ratio: 4 / 5; height: 100%; }
    .mosaic[data-hover] .tile { opacity: 1; filter: none; }
  }
</style>

<script>
  /**
   * One animation loop for the whole wall: each column drifts at its own
   * pace and wraps seamlessly (every column holds its photos twice). The
   * pace eases towards a crawl while the pointer is on the wall. On a phone
   * the rows scroll, so a swipe moves them by hand and the drift picks up
   * again afterwards.
   */
  document.querySelectorAll<HTMLElement>('[data-mosaic]').forEach((root) => {
    const cols = [...root.querySelectorAll<HTMLElement>('[data-col]')].map((col) => ({
      col,
      track: col.querySelector<HTMLElement>('[data-track]')!,
      speed: Number(col.dataset.speed ?? 24),
      dir: Number(col.dataset.dir ?? 1),
      offset: 0,
      heldUntil: 0,
    }));
    // One full loop: from the first photo to the same photo's second copy.
    const loop = (track: HTMLElement, horizontal: boolean) => {
      const tiles = track.children;
      const second = tiles[tiles.length / 2] as HTMLElement | undefined;
      const first = tiles[0] as HTMLElement | undefined;
      if (!first || !second) return 1;
      return horizontal ? second.offsetLeft - first.offsetLeft : second.offsetTop - first.offsetTop;
    };
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const phone = matchMedia('(max-width: 960px)');
    let pace = 1;
    let paceTarget = 1;
    let visible = true;
    let last = performance.now();

    // A swipe holds a row's drift for a moment.
    cols.forEach((c) => {
      const hold = () => (c.heldUntil = performance.now() + 2500);
      c.col.addEventListener('touchstart', hold, { passive: true });
      c.col.addEventListener('wheel', hold, { passive: true });
      c.col.addEventListener('pointerdown', hold);
    });

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      root.setAttribute('data-hover', '');
      paceTarget = 0.12;
    });
    root.addEventListener('pointerleave', () => {
      root.removeAttribute('data-hover');
      paceTarget = 1;
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      last = performance.now();
      if (visible) requestAnimationFrame(frame);
    }).observe(root);

    function frame(now: number) {
      if (!visible) return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      pace += (paceTarget - pace) * Math.min(1, dt * 4);

      if (!still.matches) {
        for (const c of cols) {
          if (phone.matches) {
            if (now < c.heldUntil) continue;
            const half = loop(c.track, true);
            c.col.scrollLeft += c.speed * pace * dt * c.dir;
            if (c.col.scrollLeft >= half) c.col.scrollLeft -= half;
            if (c.col.scrollLeft <= 0) c.col.scrollLeft += half;
          } else {
            const half = loop(c.track, false);
            c.offset = (c.offset + c.speed * pace * dt * c.dir + half) % half;
            c.track.style.transform = `translate3d(0, ${-c.offset}px, 0)`;
          }
        }
      }
      requestAnimationFrame(frame);
    }

    // Phone rows start in the middle of their loop, so both directions work.
    const placeRows = () => {
      if (!phone.matches) {
        cols.forEach((c) => (c.col.scrollLeft = 0));
        return;
      }
      cols.forEach((c) => (c.col.scrollLeft = loop(c.track, true) / 2));
    };
    placeRows();
    phone.addEventListener('change', placeRows);
    requestAnimationFrame(frame);
  });
</script>
