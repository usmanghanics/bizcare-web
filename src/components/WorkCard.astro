---
import type { CollectionEntry } from 'astro:content';
import Frame from './Frame.astro';
import Icon from './Icon.astro';
import StoreBadges from './StoreBadges.astro';
import { u } from '../lib/url';

/**
 * One app: its real screen in a Galaxy phone rising from a dark stage, then
 * who it is for, one line and the two store badges.
 */
interface Props {
  app: CollectionEntry<'apps'>;
  screen?: number;
}
const { app, screen = 0 } = Astro.props;
const a = app.data;
const s = a.screens[Math.min(screen, a.screens.length - 1)];
const live = a.status === 'live';
---

<article class="work reveal">
  <a class="stage" href={u(`/apps/${app.id}/`)} aria-label={`${a.name}, view project`}>
    <Frame kind="phone" src={s.src} alt={s.alt} sizes="(max-width: 640px) 60vw, 250px" class="ph" />
  </a>
  <div class="body">
    <p class="who">{a.kind === 'own' ? 'BizCare Product' : a.client}</p>
    <h3 class="title"><a href={u(`/apps/${app.id}/`)}>{a.name}</a></h3>
    <p class="line">{a.tagline}</p>
    <StoreBadges appStore={a.links.appStore} play={a.links.play} live={live} />
    <a class="link more" href={u(`/apps/${app.id}/`)}>View Project <Icon name="caret-right" size={16} /></a>
  </div>
</article>

<style>
  .work { display: flex; flex-direction: column; height: 100%; }
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
    height: 420px;
    padding-top: 44px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #101012;
    border: 1px solid #1f1f22;
    transition: border-color 0.3s var(--ease);
  }
  .stage:hover { border-color: #3a3a3c; }
  .stage :global(.ph) { width: 230px; flex: none; transition: transform 0.6s var(--ease); }
  .stage:hover :global(.ph) { transform: translateY(-10px); }
  .body { display: grid; gap: 10px; align-content: start; padding: 24px 4px 0; flex: 1; }
  .who { font-size: 0.875rem; font-weight: 650; color: var(--teal-bright); }
  .title { font-size: 1.75rem; font-weight: 750; letter-spacing: -0.035em; line-height: 1.05; }
  .line { color: var(--d-ink-2); line-height: 1.5; max-width: 38ch; }
  .body :global(.badges) { margin-top: 6px; }
  .more { margin-top: 6px; color: var(--white); }
  @media (max-width: 640px) {
    .stage { height: 380px; }
    .stage :global(.ph) { width: 210px; }
  }
</style>
