---
import { getCollection } from 'astro:content';

/** Client names sliding past, in place of a logo wall (the mills have no logos). */
const clients = await getCollection('clients');
// A steady mix of regions, newest first within each.
const byRegion = new Map<string, string[]>();
for (const c of [...clients].sort((a, b) => b.data.since.localeCompare(a.data.since))) {
  const list = byRegion.get(c.data.region.id) ?? [];
  list.push(c.data.name);
  byRegion.set(c.data.region.id, list);
}
const names: string[] = [];
for (let i = 0; names.length < 28; i++) {
  let added = false;
  for (const list of byRegion.values()) {
    if (list[i] && names.length < 28 && !names.includes(list[i])) {
      names.push(list[i]);
      added = true;
    }
  }
  if (!added) break;
}
---

<div class="marquee" aria-label="Some of our clients">
  <ul class="track">
    {names.map((n) => <li>{n}</li>)}
  </ul>
  <ul class="track" aria-hidden="true">
    {names.map((n) => <li>{n}</li>)}
  </ul>
</div>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    flex: none;
    gap: 0;
    animation: slide 90s linear infinite;
  }
  .marquee:hover .track { animation-play-state: paused; }
  .track li {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #8f8f8f;
    white-space: nowrap;
  }
  .track li::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }
  @keyframes slide { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
</style>
