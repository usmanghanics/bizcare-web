---
/** A large headline and one line under it. `label` is kept for reference only and is not shown. */
interface Props {
  label?: string;
  title: string;
  line?: string;
  center?: boolean;
  level?: 1 | 2;
  id?: string;
  size?: 'display' | 'h2';
}
const { title, line, center = false, level = 2, id, size = level === 1 ? 'display' : 'h2' } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class:list={['head', 'reveal', { 'head-center': center }]}>
  <Heading class={size} id={id} set:html={title} />
  {line && <p class="lede">{line}</p>}
  <slot />
</div>
