---
import { numbers } from '../data/site';
---

<section class="strip-wrap" aria-label="BizCare in numbers">
  <div class="wrap">
    <ul class="strip reveal">
      {
        numbers.map((n) => (
          <li>
            <span class="value num">{n.value}</span>
            <span class="name">{n.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .strip li {
    display: grid;
    gap: 4px;
    justify-items: center;
    padding: 28px 12px;
    text-align: center;
  }
  .strip li + li { border-left: 1px solid var(--line); }
  .value {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .name { font-size: 0.9375rem; font-weight: 650; color: var(--ink-2); }
  @media (max-width: 760px) {
    .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .strip li { padding: 20px 8px; }
    .strip li + li { border-left: 0; }
    .strip li:nth-child(even) { border-left: 1px solid var(--line); }
    .strip li:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .strip li:last-child { grid-column: 1 / -1; border-left: 0; }
  }
</style>
