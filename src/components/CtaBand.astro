---
import BrandIcon from './BrandIcon.astro';
import FillButton from './FillButton.astro';
import GooButton from './GooButton.astro';
import Icon from './Icon.astro';
import { company, whatsappHref } from '../data/site';
import { u } from '../lib/url';

/**
 * The closing card: one headline, one line, the two actions, and the three
 * direct ways to reach BizCare beside them.
 */
interface Props {
  title?: string;
  line?: string;
  /** Product to pre-select on the demo form. */
  product?: string;
  /** Message written for the visitor on WhatsApp. */
  message?: string;
}
const {
  title = 'Ready to See It on <span class="teal">Your Business?</span>',
  line = 'Book a short demo. We show you the software that fits, on a call or at your place.',
  product,
  message = 'Hello BizCare, I would like a demo.',
} = Astro.props;
const demo = u(product ? `/contact/?product=${product}` : '/contact/');
---

<section class="cta-wrap">
  <div class="wrap">
    <div class="cta dark reveal">
      <div class="left">
        <h2 class="h2" set:html={title} />
        <p class="lede">{line}</p>
        <div class="btn-row">
          <FillButton href={u('/products/')}>See Products</FillButton>
          <GooButton href={demo} icon="calendar-check">Book a Demo</GooButton>
        </div>
      </div>
      <ul class="ways">
        <li>
          <a href={whatsappHref(message)} target="_blank" rel="noopener">
            <BrandIcon name="whatsapp" size={26} />
            <span><span class="k">WhatsApp</span><span class="v num">{company.phone}</span></span>
            <Icon name="caret-right" size={18} class="go" />
          </a>
        </li>
        <li>
          <a href={company.phoneHref}>
            <span class="ic"><Icon name="phone" size={18} /></span>
            <span><span class="k">Call</span><span class="v num">{company.phone}</span></span>
            <Icon name="caret-right" size={18} class="go" />
          </a>
        </li>
        <li>
          <a href={`mailto:${company.email}`}>
            <span class="ic"><Icon name="envelope-simple" size={18} /></span>
            <span><span class="k">Email</span><span class="v">{company.email}</span></span>
            <Icon name="caret-right" size={18} class="go" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cta-wrap { padding: var(--section) 0; background: var(--bg); }
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
    align-items: center;
    padding: 64px;
    border-radius: 32px;
    background: #0c0c0d;
    border: 1px solid #1f1f22;
  }
  .left { display: grid; gap: 22px; justify-items: start; }
  .left .h2 { max-width: 15ch; }
  .left .lede { max-width: 48ch; }
  .left .btn-row { margin-top: 8px; }
  .ways { display: grid; gap: 10px; }
  .ways a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 18px;
    background: #161618;
    border: 1px solid #232326;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .ways a:hover { border-color: #3a3a3c; background: #1a1a1c; }
  .ways a > span:nth-child(2) { flex: 1; display: grid; }
  .ic { display: grid; place-items: center; width: 26px; height: 26px; color: var(--teal-bright); }
  .k { font-size: 0.8125rem; color: var(--d-ink-3); }
  .v { font-size: 1.0625rem; font-weight: 700; color: var(--white); }
  .ways :global(.go) { color: #6b6b6b; transition: transform 0.2s var(--ease); }
  .ways a:hover :global(.go) { transform: translateX(3px); color: var(--white); }
  @media (max-width: 960px) {
    .cta { grid-template-columns: minmax(0, 1fr); padding: 44px 32px; gap: 36px; }
  }
  @media (max-width: 480px) {
    .cta { padding: 36px 22px; border-radius: 24px; }
  }
</style>
