---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Frame from './Frame.astro';
import Icon from './Icon.astro';
import { u } from '../lib/url';
import desk from '../assets/photos/software-desk.jpg';
import whatsapp from '../assets/photos/whatsapp.jpg';
import marketing from '../assets/photos/marketing.jpg';

/** What BizCare does, as four numbered services, each with a real picture. */
const makki = (await getEntry('apps', 'makki-autocare'))!;
const items = [
  { title: 'Business Software', line: 'ERP and point of sale for flour mills, retail, restaurants, travel, workshops and internet providers.', href: '/products/', img: desk },
  { title: 'Mobile Apps', line: 'Apps that put your records in your customers’ hands, for Android and iPhone.', href: '/apps/', phone: makki.data.screens[0] },
  { title: 'WhatsApp Cloud API', line: 'Invoices, receipts and reminders sent to customers on WhatsApp, automatically.', href: '/services/whatsapp-cloud-api/', img: whatsapp },
  { title: 'Digital Marketing', line: 'Search, social media, content and ads that bring customers to your door.', href: '/services/digital-marketing/', img: marketing },
];
---

<ul class="services">
  {
    items.map((s, i) => (
      <li class="reveal">
        <a class="svc" href={u(s.href)}>
          <div class="pic">
            {s.img && (
              <Picture
                src={s.img}
                alt=""
                formats={['avif', 'webp']}
                widths={[360, 540, 720]}
                sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 300px"
                quality={66}
                loading="lazy"
                decoding="async"
              />
            )}
            {s.phone && <Frame kind="phone" src={s.phone.src} alt="" sizes="150px" class="mini" />}
          </div>
          <span class="n num">0{i + 1}</span>
          <h3 class="h3">{s.title}</h3>
          <p class="muted small">{s.line}</p>
          <span class="link small">
            Learn More <Icon name="caret-right" size={16} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .services { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .svc { display: grid; gap: 12px; align-content: start; }
  .pic {
    position: relative;
    display: grid;
    place-items: start center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: #0d0d0d;
    margin-bottom: 10px;
  }
  .pic :global(picture), .pic :global(img) { width: 100%; height: 100%; }
  .pic :global(img) { object-fit: cover; transition: transform 0.7s var(--ease); }
  .svc:hover .pic :global(img) { transform: scale(1.04); }
  .pic :global(.mini) { width: 44%; margin-top: 26px; transition: transform 0.6s var(--ease); }
  .svc:hover .pic :global(.mini) { transform: translateY(-6px); }
  .n { font-size: 0.875rem; font-weight: 800; color: var(--teal); letter-spacing: 0.04em; }
  .link { margin-top: 4px; }
  .svc:hover .link :global(svg) { transform: translateX(4px); }
  @media (max-width: 1080px) { .services { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; } }
  @media (max-width: 560px) { .services { grid-template-columns: minmax(0, 1fr); } }
</style>
