---
/** The black top of every inner page: label, large headline, one line, then anything else. */
interface Props {
  label?: string;
  title: string;
  line?: string;
  /** Leave room at the bottom for an image that overlaps into the next band. */
  bridge?: boolean;
}
const { label, title, line, bridge = false } = Astro.props;
---

<section class:list={['page-hero dark', { bridge }]}>
  <div class="wrap inner">
    {label && <span class="eyebrow">{label}</span>}
    <h1 class="display" set:html={title} />
    {line && <p class="lede">{line}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding: calc(var(--bar) + 104px) 0 112px; }
  .bridge { padding-bottom: 220px; }
  .inner { display: grid; gap: 26px; justify-items: start; }
  .inner > :global(.display) { max-width: 15ch; }
  .inner > :global(.lede) { max-width: 640px; }
  @media (max-width: 640px) {
    .page-hero { padding: calc(var(--bar) + 56px) 0 72px; }
    .bridge { padding-bottom: 120px; }
  }
</style>
